<?php

/**
 * @file
 * Functions to support theming in the Olivero theme.
 */

use Drupal\apc_brown\OliveroPreRender;
use Drupal\Component\Utility\Html;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\image\Entity\ImageStyle;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_theme().
 */
function apc_brown_theme($existing, $type, $theme, $path) {
  return [
    'apc_front_page' => [
      'template' => 'front-page',
      'variables' => [
        'featured_event' => NULL,
        'upcoming_events' => [],
        'signs_pool' => [],
        'signs_wall' => NULL,
      ],
    ],
    'apc_upcoming_events' => [
      'template' => 'upcoming-events',
      'variables' => [
        'cards' => [],
        'pager' => NULL,
        'signs_sidebar' => NULL,
        'recent_posts' => NULL,
      ],
    ],
    'apc_locations_page' => [
      'template' => 'locations-page',
      'variables' => [
        // Raw term entities + precomputed next-event data, same split as
        // apc_front_page's signs_pool -- see
        // apc_brown_preprocess_apc_locations_page().
        'terms' => [],
        'next_events' => [],
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for HTML document templates.
 *
 * Adds body classes if certain regions have content.
 */
function apc_brown_preprocess_html(&$variables) {
  if (theme_get_setting('mobile_menu_all_widths') === 1) {
    $variables['attributes']['class'][] = 'is-always-mobile-nav';
  }

  // Lets the calendar grid claim more of the content column -- see the
  // .page-calendar override in css/theme/apc.css. There's no sidebar
  // content on this page to make room for either way (confirmed: no
  // block.block.apc_brown_* is placed in the sidebar region), so widening
  // it has nothing to collide with.
  if (\Drupal::routeMatch()->getRouteName() === 'view.calendar.page_1') {
    $variables['attributes']['class'][] = 'page-calendar';
  }

  // Same reasoning as page-calendar above: this page's own sidebar (the
  // filters column, see views-view--photo-gallery--page-1.html.twig) isn't
  // Olivero's page.sidebar region, so there's no competing sidebar content
  // to leave room for -- confirmed no block.block.apc_brown_* sits in the
  // sidebar region here either. Widening the content column gives the photo
  // grid enough room for 3 comfortably-sized columns instead of being
  // squeezed by the site-wide "medium" content width meant for body text.
  if (\Drupal::routeMatch()->getRouteName() === 'view.photo_gallery.page_1') {
    $variables['attributes']['class'][] = 'page-photo-gallery';
  }

  // Event/location detail pages: lets .page-event-detail/.page-location-detail
  // in css/components/detail-page.css pull the top of the page (the generic
  // .main-content__container padding and .region--breadcrumb margin, both
  // sized for content-heavy pages with local tasks and several stacked
  // blocks) in closer to the title -- these two pages' content starts with a
  // big title of its own and doesn't need that much clearance above it.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'entity.node.canonical') {
    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof NodeInterface && $node->bundle() === 'calendar_event') {
      $variables['attributes']['class'][] = 'page-event-detail';
    }
  }
  elseif ($route_name === 'entity.taxonomy_term.canonical') {
    $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
    if ($term instanceof \Drupal\taxonomy\TermInterface && $term->bundle() === 'locations') {
      $variables['attributes']['class'][] = 'page-location-detail';
    }
  }

  // Convert custom hex to hsl so we can use the hue value
  $brand_color_hex = theme_get_setting('base_primary_color') ?? '#1b9ae4';
  [$h, $s, $l] = _apc_brown_hex_to_hsl($brand_color_hex);

  $variables['html_attributes']->setAttribute('style', "--color--primary-hue:$h;--color--primary-saturation:$s%;--color--primary-lightness:$l");

  // So fonts can be preloaded from base theme in the event Olivero is used as a subtheme.
  $variables['apc_brown_path'] = \Drupal::request()->getBasePath() . '/' . \Drupal::service('extension.list.theme')->getPath('apc_brown');

  $query_string = \Drupal::service('asset.query_string')->get();

  // Create render array with noscript tag to output non-JavaScript
  // stylesheet for primary menu.
  $variables['noscript_styles'] = [
    '#type' => 'html_tag',
    '#noscript' => TRUE,
    '#tag' => 'link',
    '#attributes' => [
      'rel' => 'stylesheet',
      'href' => $variables['apc_brown_path'] . '/css/components/navigation/nav-primary-no-js.css?' . $query_string,
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page title templates.
 */
function apc_brown_preprocess_page_title(&$variables) {
  // Since the title and the shortcut link are both block level elements,
  // positioning them next to each other is much simpler with a wrapper div.
  if (!empty($variables['title_suffix']['add_or_remove_shortcut']) && $variables['title']) {
    // Add a wrapper div using the title_prefix and title_suffix render
    // elements.
    $variables['title_prefix']['shortcut_wrapper'] = [
      '#markup' => '<div class="shortcut-wrapper">',
      '#weight' => 100,
    ];
    $variables['title_suffix']['shortcut_wrapper'] = [
      '#markup' => '</div>',
      '#weight' => -99,
    ];

    // Make sure the shortcut link is the first item in title_suffix.
    $variables['title_suffix']['add_or_remove_shortcut']['#weight'] = -100;
  }

  // Unset shortcut link on front page.
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  if ($variables['is_front'] === TRUE) {
    unset($variables['title_suffix']['add_or_remove_shortcut']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for maintenance-page.html.twig.
 */
function apc_brown_preprocess_maintenance_page(&$variables) {
  // By default, site_name is set to Drupal if no db connection is available
  // or during site installation. Setting site_name to an empty string makes
  // the site and update pages look cleaner.
  // @see template_preprocess_maintenance_page
  if (!$variables['db_is_active']) {
    $variables['site_name'] = '';
  }

  // Olivero has custom styling for the maintenance page.
  $variables['#attached']['library'][] = 'apc_brown/maintenance-page';
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function apc_brown_preprocess_node(&$variables) {
  // Remove the "Add new comment" link on teasers or when the comment form is
  // displayed on the page.
  if ($variables['teaser'] || !empty($variables['content']['comments']['comment_form'])) {
    unset($variables['content']['links']['comment']['#links']['comment-add']);
  }

  // Apply custom date formatter to "date" field.
  if (!empty($variables['date']) && !empty($variables['display_submitted']) && $variables['display_submitted'] === TRUE) {
    $variables['date'] = \Drupal::service('date.formatter')->format($variables['node']->getCreatedTime(), 'apc_brown_medium');
  }

  // The calendar popup (calendar_item view mode) has no use for "By admin,
  // [submission date]" -- nobody visiting the calendar cares who typed the
  // event in or when, and EventPopupController already puts the thing that
  // actually matters (the event's own date + an "Add to calendar" button,
  // apc_datebar) at the top of content, right where this would otherwise sit
  // in node.html.twig's <header>. display_submitted is a content-type-wide
  // setting (node.type.calendar_event.yml), so it's still TRUE for the full
  // event page -- that page never prints node__meta anyway, being a
  // from-scratch template (node--calendar-event--full.html.twig) that never
  // references display_submitted at all.
  if ($variables['node']->bundle() === 'calendar_event' && $variables['view_mode'] === 'calendar_item') {
    $variables['display_submitted'] = FALSE;
  }

  // Pass layout variable to template if content type is article in full view
  // mode. This is then used in the template to create a BEM style CSS class to
  // control the layout.
  if ($variables['node']->bundle() === 'article' && $variables['view_mode'] === 'full') {
    $variables['layout'] = 'content-narrow';
  }

  if ($variables['node']->bundle() === 'community_photo' && $variables['view_mode'] === 'full') {
    _apc_brown_preprocess_community_photo($variables);
  }

  // Build the click-to-swap gallery for the event detail page. Not done via
  // field formatter settings: the interactive hero/thumbnail markup needs
  // precomputed mobile+desktop URLs on each thumbnail (see
  // apc_brown/gallery), which a standard field template has no clean way to
  // expose.
  if ($variables['node']->bundle() === 'calendar_event' && $variables['view_mode'] === 'full') {
    $variables['gallery'] = _apc_brown_build_gallery($variables['node'], 'field_event_image');
    // Not every organizer uploads a photo -- confirmed live, several of this
    // site's own events have none, which otherwise left the whole gallery
    // slot empty (the template drops it via {% if gallery %}). The default
    // is a single static SVG, not a managed file with real derivatives, so
    // every size key below just points at the same URL; the browser scales
    // it, and there is nothing here for the click-to-swap thumbnail rail to
    // switch between (it only shows when gallery has 2+ items).
    if (!$variables['gallery']) {
      $default_url = \Drupal\apc_calendar\DefaultEventImage::url();
      $variables['gallery'] = [[
        'hero_mobile' => $default_url,
        'hero_desktop' => $default_url,
        'thumb' => $default_url,
        'full' => $default_url,
        'alt' => t('Austin skyline illustration with the Austin Progressive Calendar mascot'),
      ]];
    }
    // Multi-provider "Add to calendar" control (Google/Apple/Outlook/Yahoo),
    // built by the apc_calendar module so the full page, the popup and the
    // .ics route all share one implementation. Delta 0 = first/next occurrence
    // (the full page has no clicked occurrence). Empty array when undated, so
    // the template's {% if add_to_calendar %} drops it cleanly.
    $variables['add_to_calendar'] = \Drupal\apc_calendar\AddToCalendar::build($variables['node']);

    // Visual "unpublished" banner. Shown to anyone who can reach this page at
    // all (event_manager and administrator, per apc_calendar_node_access())
    // -- not gated on update access like the publish button below, since a
    // future viewer with view-only access to pending content should still
    // see this. Depends only on the node's own status, which is already
    // covered by the entity's own node:NID cache tag, so no extra cache
    // context is needed here (unlike publish_event_url below).
    $variables['is_unpublished'] = !$variables['node']->isPublished();

    // One-click "publish event + location" button for reviewers. Gate
    // mirrors the target route's own _entity_access: 'node.update'
    // requirement exactly, so the button never appears when the link
    // underneath it would 403 (see apc_calendar_node_access(), which is what
    // lets a reviewer reach this page for an unpublished event at all).
    if (!$variables['node']->isPublished() && $variables['node']->access('update')) {
      $variables['publish_event_url'] = Url::fromRoute('apc_calendar.publish_event_and_location', [
        'node' => $variables['node']->id(),
      ])->toString();
      // The URL embeds a per-session CSRF token and its own visibility
      // depends on the viewer's permissions, so both must be added here --
      // otherwise a cached render could show the button (or a stale token)
      // to the wrong viewer.
      $variables['#cache']['contexts'][] = 'user.permissions';
      $variables['#cache']['contexts'][] = 'session';
    }
    // Reviewer unpublish controls on an already-published event -- same gate,
    // CSRF token and cache contexts as the publish button above.
    elseif ($variables['node']->isPublished() && $variables['node']->access('update')) {
      $variables['unpublish_event_url'] = Url::fromRoute('apc_calendar.unpublish_event', [
        'node' => $variables['node']->id(),
      ])->toString();
      $variables['unpublish_all_url'] = Url::fromRoute('apc_calendar.unpublish_event_and_location', [
        'node' => $variables['node']->id(),
      ])->toString();
      $variables['#cache']['contexts'][] = 'user.permissions';
      $variables['#cache']['contexts'][] = 'session';
    }

    // Address, map and directions all now come from content.field_location
    // itself -- the location_reference view mode gained a 'directions'
    // component alongside its existing address/map, so the embedded render
    // covers the whole "Location card" without this hook needing to call
    // apc_calendar_build_directions() separately.
    if ($variables['node']->hasField('field_location') && !$variables['node']->get('field_location')->isEmpty()) {
      $term = $variables['node']->get('field_location')->entity;

      // A location term auto-created by an anonymous submitter stays
      // unpublished until an admin approves it (apc_calendar_taxonomy_term_
      // presave()). The event itself can already be published -- e.g. a
      // manager approved the event but hasn't gotten to the location yet --
      // so an anonymous visitor can land here with a real term reference
      // that entity_reference_label's own access check then silently
      // renders as nothing (content.field_location evaluates to an empty
      // but still-truthy render array, leaving a "Location" card with a
      // blank value). Show "Pending" instead of leaving that card looking
      // broken, without revealing the actual unapproved venue name to a
      // visitor who has no access to it.
      if ($term !== NULL && !$term->isPublished() && \Drupal::currentUser()->isAnonymous()) {
        $variables['location_pending'] = TRUE;
      }
      // Same access gate as the field formatter itself would apply --
      // skip building this from a term the current viewer has no access to,
      // rather than leaking its photos/link past the "Pending" card above.
      elseif ($term !== NULL && $term->access('view')) {
        $variables['location_gallery'] = _apc_brown_build_gallery($term, 'field_location_image');
        $variables['location_url'] = $term->toUrl()->toString();
      }
    }

    // Source attribution for events pulled in via Feeds (event-import-
    // task.md) -- offering a credited link back is the whole point of
    // field_source_url on the event_sources term, since it's what a source
    // org gets in exchange for letting this site aggregate their calendar.
    // Empty field_event_source is meaningful (a human submission), so this
    // is silently skipped rather than shown with a placeholder.
    if ($variables['node']->hasField('field_event_source') && !$variables['node']->get('field_event_source')->isEmpty()) {
      $source_term = $variables['node']->get('field_event_source')->entity;
      if ($source_term !== NULL) {
        $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $source_term->getCacheTags());
        $variables['event_source_label'] = $source_term->label();
        if ($source_term->hasField('field_source_url') && !$source_term->get('field_source_url')->isEmpty()) {
          $variables['event_source_url'] = $source_term->get('field_source_url')->first()->getUrl()->toString();
        }
      }
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for taxonomy_term.html.twig.
 *
 * Unlike node_theme_suggestions_node(), core's
 * taxonomy_theme_suggestions_taxonomy_term() only adds
 * 'taxonomy_term__BUNDLE' and 'taxonomy_term__ID' — no bundle+view-mode
 * combined suggestion, so a 'taxonomy-term--locations--full.html.twig' file
 * is silently never picked up without this.
 */
function apc_brown_theme_suggestions_taxonomy_term_alter(array &$suggestions, array $variables): void {
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $variables['elements']['#taxonomy_term'];
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'taxonomy_term__' . $term->bundle() . '__' . $view_mode;

  // 'tags' (calendar_event's field_tags) and 'photo_categories'
  // (community_photo's field_photo_tags) are two separate vocabularies --
  // confirmed live it's genuinely two, not one shared 'tags' vocabulary as
  // the field names alone suggest -- but they need the exact same "show
  // what's tagged with this" treatment, so both get this one shared
  // suggestion rather than duplicating a template file per vocabulary.
  if (in_array($term->bundle(), ['tags', 'photo_categories'], TRUE) && $view_mode === 'full') {
    $suggestions[] = 'taxonomy_term__tagged_content__full';
  }
}

/**
 * Implements hook_preprocess_HOOK() for taxonomy-term.html.twig.
 */
function apc_brown_preprocess_taxonomy_term(&$variables) {
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $variables['term'];

  if ($term->bundle() === 'locations' && $variables['view_mode'] === 'full') {
    $variables['gallery'] = _apc_brown_build_gallery($term, 'field_location_image');

    // Visual "unpublished" banner -- same rationale as the node version in
    // apc_brown_preprocess_node(). Depends only on the term's own status, so
    // no extra cache context is needed (covered by the term's own cache tag).
    $variables['is_unpublished'] = !$term->isPublished();

    // The upcoming/past events lists were split out of location_page's old
    // page/attachment displays into standalone block displays (block_upcoming,
    // block_past) specifically so they could be embedded here.
    $variables['upcoming_events'] = \Drupal\views\Views::getView('location_page')?->buildRenderable('block_upcoming', [$term->id()]);
    $variables['past_events'] = \Drupal\views\Views::getView('location_page')?->buildRenderable('block_past', [$term->id()]);
  }
  elseif (in_array($term->bundle(), ['tags', 'photo_categories'], TRUE) && $variables['view_mode'] === 'full') {
    // A tags or photo_categories term page rendered no content at all --
    // clicking a tag pill on the photo gallery or an event landed on a page
    // with just the term's own fields (e.g. the keyword-matching "Match
    // keywords" list) and nothing tagged with it, confirmed live. These are
    // two separate vocabularies (calendar_event's field_tags targets 'tags',
    // community_photo's field_photo_tags targets 'photo_categories' --
    // confirmed live it's genuinely two, not one shared vocabulary the field
    // names alone would suggest), but both need the same fix. Core's own
    // taxonomy_term view would normally provide that listing, but it's
    // deliberately disabled site-wide (see views.view.taxonomy_term.yml,
    // status: false) because its own page route at taxonomy/term/%25
    // hijacked the locations vocabulary's own term page. tagged_content is a
    // block-only view (no page display, no route) built specifically so it
    // can be embedded here for these two alone without going anywhere near
    // that conflict again.
    $variables['tagged_content'] = \Drupal\views\Views::getView('tagged_content')?->buildRenderable('block_1', [$term->id()]);
  }
}

/**
 * HTML-escapes $text and wraps any bare http(s) URLs in it with <a> tags
 * that open in a new tab, leaving everything else as plain escaped text.
 * Deliberately not a full markup/BBCode syntax -- just auto-linking, for
 * captions on field_caption (a plain string field, not formatted text).
 *
 * Returns a Markup object so Twig prints it as-is instead of re-escaping the
 * <a> tags this function just built; callers should only call this on
 * non-empty text (an empty Markup object is still truthy to Twig's `if`,
 * unlike an empty string).
 */
function _apc_brown_linkify_urls(string $text): Markup {
  $escaped = Html::escape($text);
  $html = preg_replace_callback('#(https?://[^\s<]+)#i', function (array $match): string {
    // Trailing punctuation right at the end of the match is usually
    // sentence punctuation, not part of the URL (e.g. "see https://x.org.").
    $url = rtrim($match[1], '.,;:!?)]}\'"');
    $suffix = substr($match[1], strlen($url));
    return '<a href="' . $url . '" target="_blank" rel="noopener noreferrer">' . $url . '</a>' . $suffix;
  }, $escaped);
  return Markup::create($html);
}

/**
 * Implements hook_preprocess_HOOK() for the apc_front_page theme hook.
 *
 * FrontPageController passes raw entities, not markup, for the same reason
 * apc_brown_preprocess_taxonomy_term() builds its own Views embeds rather
 * than a controller: the theme layer owns ImageStyle usage and Views
 * embedding for every other custom template in this codebase, so the front
 * page follows the same split.
 */
function apc_brown_preprocess_apc_front_page(&$variables) {
  $thumb_style = ImageStyle::load('gallery_thumb');
  $file_url = \Drupal::service('file_url_generator');

  $pool = [];
  foreach ($variables['signs_pool'] as $node) {
    if (!$node->hasField('field_photo_image') || $node->get('field_photo_image')->isEmpty()) {
      continue;
    }
    $media = $node->get('field_photo_image')->entity;
    if ($media === NULL || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
      continue;
    }
    $image_item = $media->get('field_media_image')->first();
    $file = $image_item->entity;
    if ($file === NULL) {
      continue;
    }
    $uri = $file->getFileUri();
    $caption = $node->hasField('field_caption') ? (string) $node->get('field_caption')->value : '';
    $pool[] = [
      'thumb' => $thumb_style->buildUrl($uri),
      'full' => $file_url->generateAbsoluteString($uri),
      'alt' => $image_item->get('alt')->getString() ?: $media->label(),
      'caption' => $caption !== '' ? _apc_brown_linkify_urls($caption) : '',
    ];
    $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $node->getCacheTags());
  }
  $variables['signs_pool'] = $pool;

  // Same block-display embedding pattern as the location page's
  // upcoming/past events lists.
  $view = \Drupal\views\Views::getView('photo_gallery');
  $variables['signs_wall'] = $view?->access('wall_recent_all') ? $view->buildRenderable('wall_recent_all') : NULL;
}

/**
 * Implements hook_preprocess_HOOK() for the apc_upcoming_events theme hook.
 *
 * Same reasoning as apc_brown_preprocess_apc_front_page() just above: the
 * controller passes cards it already rendered, the theme layer owns the
 * Views embeds for the sidebar (signs wall + recent blog posts).
 */
function apc_brown_preprocess_apc_upcoming_events(&$variables) {
  $photo_gallery = \Drupal\views\Views::getView('photo_gallery');
  $variables['signs_sidebar'] = $photo_gallery?->access('wall_recent_all') ? $photo_gallery->buildRenderable('wall_recent_all') : NULL;

  $blog = \Drupal\views\Views::getView('blog');
  $variables['recent_posts'] = $blog?->access('block_recent_posts') ? $blog->buildRenderable('block_recent_posts') : NULL;
}

/**
 * Implements hook_preprocess_HOOK() for the apc_locations_page theme hook.
 *
 * LocationsController passes raw term entities + precomputed "next event"
 * data (EventCardBuilder::findNextEventAtLocation()) -- same split as
 * apc_front_page's signs_pool: the controller owns the query, the theme
 * layer owns ImageStyle usage for the actual card data.
 */
function apc_brown_preprocess_apc_locations_page(&$variables) {
  $thumb_style = ImageStyle::load('gallery_thumb');
  $default_image = \Drupal\apc_calendar\DefaultEventImage::url();

  $cards = [];
  foreach ($variables['terms'] as $term) {
    $image_url = $default_image;
    if ($term->hasField('field_location_image') && !$term->get('field_location_image')->isEmpty()) {
      $media = $term->get('field_location_image')->entity;
      if ($media !== NULL && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
        $file = $media->get('field_media_image')->entity;
        if ($file !== NULL) {
          $image_url = $thumb_style->buildUrl($file->getFileUri());
        }
      }
    }

    // Locality + state is enough to place a venue at a glance on a card --
    // the full street address is one click away on the location's own page.
    $address_line = '';
    if ($term->hasField('field_address') && !$term->get('field_address')->isEmpty()) {
      $address = $term->get('field_address')->first()->getValue();
      $address_line = trim(implode(', ', array_filter([
        $address['locality'] ?? '',
        $address['administrative_area'] ?? '',
      ])));
    }

    $cards[] = [
      'name' => $term->label(),
      'url' => $term->toUrl()->toString(),
      'image' => $image_url,
      'address' => $address_line,
      'next_event' => $variables['next_events'][$term->id()] ?? NULL,
    ];
  }
  $variables['locations'] = $cards;
}

/**
 * Builds the click-to-swap gallery variable for a node or term template.
 *
 * @see apc_brown_preprocess_node()
 * @see apc_brown_preprocess_taxonomy_term()
 */
function _apc_brown_build_gallery(FieldableEntityInterface $entity, string $field_name): array {
  $items = [];

  if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
    return $items;
  }

  $hero_mobile_style = ImageStyle::load('gallery_hero_mobile');
  $hero_desktop_style = ImageStyle::load('gallery_hero_desktop');
  $thumb_style = ImageStyle::load('gallery_thumb');

  foreach ($entity->get($field_name) as $item) {
    $media = $item->entity;
    if ($media === NULL || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
      continue;
    }

    $image_item = $media->get('field_media_image')->first();
    $file = $image_item->entity;
    if ($file === NULL) {
      continue;
    }

    $uri = $file->getFileUri();

    // gallery_hero_mobile/_desktop are image_scale (not crop) styles on
    // purpose -- see the "No fixed aspect-ratio" note in gallery.css -- so
    // each image keeps its own natural ratio and there's no single fixed
    // box size to hard-code here. Computing the *actual* derivative
    // dimensions per image lets the templates set real width/height
    // attributes, which is what gallery.js needs to swap the hero image
    // without the page collapsing then popping back to size around it
    // (confirmed live: with no width/height hint, the browser has nothing
    // to reserve space with until the new file finishes downloading, and
    // the resulting jump got worse the more the two images' aspect ratios
    // differed). Uses the image field's own already-stored width/height
    // (the ORIGINAL upload's dimensions -- no extra file I/O) rather than
    // re-reading the file, same as core's own image formatters do.
    $original_width = (int) ($image_item->width ?? 0);
    $original_height = (int) ($image_item->height ?? 0);
    $hero_mobile_dimensions = ['width' => $original_width, 'height' => $original_height];
    $hero_desktop_dimensions = ['width' => $original_width, 'height' => $original_height];
    if ($original_width && $original_height) {
      $hero_mobile_style->transformDimensions($hero_mobile_dimensions, $uri);
      $hero_desktop_style->transformDimensions($hero_desktop_dimensions, $uri);
    }

    $items[] = [
      'hero_mobile' => $hero_mobile_style->buildUrl($uri),
      'hero_mobile_width' => $hero_mobile_dimensions['width'] ?: NULL,
      'hero_mobile_height' => $hero_mobile_dimensions['height'] ?: NULL,
      'hero_desktop' => $hero_desktop_style->buildUrl($uri),
      'hero_desktop_width' => $hero_desktop_dimensions['width'] ?: NULL,
      'hero_desktop_height' => $hero_desktop_dimensions['height'] ?: NULL,
      'thumb' => $thumb_style->buildUrl($uri),
      // Original, uncropped -- what the lightbox shows. Deliberately not a
      // cropped style: a lightbox is the one place the focal-point crop
      // doesn't need to apply, since there's no fixed box to fill.
      'full' => \Drupal::service('file_url_generator')->generateAbsoluteString($uri),
      'alt' => $image_item->get('alt')->getString() ?: $media->label(),
    ];
  }

  return $items;
}

/**
 * Builds the community_photo detail page (node--community-photo--full).
 *
 * Renders a large hero image, caption/credit/tag metadata, and a sidebar of
 * related photos (shared category first, recent as filler). Hero and related
 * thumbnails are all wired into apc_brown/photo-lightbox's grid behavior via
 * the [data-apc-photo-grid] wrapper in the template, so clicking any of them
 * opens the same full-size, zoomable lightbox the /photos grid uses, and its
 * prev/next steps through this page's set. drupalSettings.apcPhotoGallery
 * (keyed by nid, same shape the grid builds) carries each photo's original
 * image URL + caption + credit for that lightbox.
 */
function _apc_brown_preprocess_community_photo(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];

  $hero_style = ImageStyle::load('photo_detail');
  $thumb_style = ImageStyle::load('gallery_thumb');
  $file_url = \Drupal::service('file_url_generator');

  // Pulls the image + lightbox data off a community_photo node. NULL when the
  // node has no usable image, so callers can skip it.
  $image_data = static function ($photo_node) use ($hero_style, $thumb_style, $file_url): ?array {
    if (!$photo_node->hasField('field_photo_image') || $photo_node->get('field_photo_image')->isEmpty()) {
      return NULL;
    }
    $media = $photo_node->get('field_photo_image')->entity;
    if ($media === NULL || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
      return NULL;
    }
    $item = $media->get('field_media_image')->first();
    $file = $item->entity;
    if ($file === NULL) {
      return NULL;
    }
    $uri = $file->getFileUri();
    return [
      'hero' => $hero_style->buildUrl($uri),
      'thumb' => $thumb_style->buildUrl($uri),
      'full' => $file_url->generateAbsoluteString($uri),
      'alt' => $item->get('alt')->getString() ?: $media->label(),
    ];
  };

  // Only credit a submitter who opted into public credit -- same gate the
  // gallery and the submission-confirmation page use.
  $credit_for = static function ($photo_node): ?string {
    if ($photo_node->hasField('field_credit_publicly') && $photo_node->get('field_credit_publicly')->value
      && $photo_node->hasField('field_submitter_name')) {
      $name = trim((string) $photo_node->get('field_submitter_name')->value);
      return $name !== '' ? $name : NULL;
    }
    return NULL;
  };

  $lightbox = [];
  $lightbox_entry = static function ($photo_node, array $image) use ($credit_for): array {
    $entry = [
      'full' => $image['full'],
      'alt' => $image['alt'],
      'caption' => $photo_node->hasField('field_caption') ? (string) $photo_node->get('field_caption')->value : '',
    ];
    $credit = $credit_for($photo_node);
    if ($credit !== NULL) {
      $entry['credit'] = $credit;
    }
    return $entry;
  };

  // Hero.
  $hero = $image_data($node);
  if ($hero !== NULL) {
    $variables['photo_hero'] = $hero + ['nid' => $node->id()];
    $lightbox[$node->id()] = $lightbox_entry($node, $hero);
  }
  $photo_caption = $node->hasField('field_caption') ? (string) $node->get('field_caption')->value : '';
  $variables['photo_caption'] = $photo_caption !== '' ? _apc_brown_linkify_urls($photo_caption) : '';
  $variables['photo_credit'] = $credit_for($node);
  if ($node->hasField('field_photo_tags') && !$node->get('field_photo_tags')->isEmpty()) {
    $variables['photo_tags'] = $node->get('field_photo_tags')->view([
      'label' => 'hidden',
      'type' => 'entity_reference_label',
      'settings' => ['link' => TRUE],
    ]);
  }

  // Related: shared category first, then recent as filler, published, not
  // this node, capped at 6.
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $tids = array_column($node->get('field_photo_tags')->getValue(), 'target_id');
  $related_ids = [];
  if ($tids) {
    $related_ids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'community_photo')
      ->condition('status', 1)
      ->condition('nid', $node->id(), '<>')
      ->condition('field_photo_tags', $tids, 'IN')
      ->sort('created', 'DESC')
      ->range(0, 6)
      ->execute();
  }
  $related_ids = array_values($related_ids);
  if (count($related_ids) < 6) {
    $exclude = array_merge([$node->id()], $related_ids);
    $filler = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'community_photo')
      ->condition('status', 1)
      ->condition('nid', $exclude, 'NOT IN')
      ->sort('created', 'DESC')
      ->range(0, 6 - count($related_ids))
      ->execute();
    $related_ids = array_merge($related_ids, array_values($filler));
  }

  $related = [];
  foreach ($storage->loadMultiple($related_ids) as $rel) {
    $image = $image_data($rel);
    if ($image === NULL) {
      continue;
    }
    $related[] = [
      'nid' => $rel->id(),
      'thumb' => $image['thumb'],
      'alt' => $image['alt'],
    ];
    $lightbox[$rel->id()] = $lightbox_entry($rel, $image);
  }
  $variables['photo_related'] = $related;

  $variables['photo_submit_url'] = Url::fromUri('internal:/node/add/community_photo')->toString();
  // Reviewer-only "pending" banner (a manager reaches an unpublished photo via
  // apc_calendar_node_access()); depends only on the node's own status, so its
  // cache tag already covers it.
  $variables['is_unpublished'] = !$node->isPublished();

  // A second "Back to content editing" link, fixed to the bottom of the
  // viewport to mirror core's own top-fixed one (.node-preview-backlink,
  // position: fixed via Olivero's node-preview-container.css). Core's own
  // link lives in NodePreviewForm, rendered in a separate region above the
  // page content -- an anonymous submitter previewing a long photo page (the
  // hero image alone can push the fold well down) can lose track of it after
  // scrolling, with no other way back to their in-progress, unsaved
  // submission. Same URL logic as NodePreviewForm::buildForm(): a preview is
  // always an unsaved node, so this always resolves to the add form with the
  // uuid query param that restores the in-progress submission from the
  // preview tempstore, never to a blank form.
  if (\Drupal::routeMatch()->getRouteName() === 'entity.node.preview') {
    $variables['photo_preview_backlink_url'] = Url::fromRoute('node.add', ['node_type' => $node->bundle()], [
      'query' => ['uuid' => $node->uuid()],
    ])->toString();
  }

  // photo-carousel carries photo-gallery.css (the .apc-photo-gallery__photo
  // frame styling and this page's .apc-photo-detail layout); its JS is inert
  // here since there's no [data-apc-photo-carousel]. photo-lightbox carries
  // the click-to-open lightbox used by the grid wrapper.
  $variables['#attached']['library'][] = 'apc_brown/photo-carousel';
  $variables['#attached']['library'][] = 'apc_brown/photo-lightbox';
  if ($lightbox) {
    $variables['#attached']['drupalSettings']['apcPhotoGallery'] = $lightbox;
  }
  // Related-list membership and their published state feed this page; a new or
  // newly published photo should invalidate it.
  $variables['#cache']['tags'][] = 'node_list:community_photo';
}

/**
 * Implements hook_preprocess_HOOK() for block.html.twig.
 */
function apc_brown_preprocess_block(&$variables) {
  if (!empty($variables['elements']['#id'])) {
    /** @var \Drupal\block\BlockInterface $block */
    $block = \Drupal::entityTypeManager()
      ->getStorage('block')
      ->load($variables['elements']['#id']);
    if ($block) {
      $region = $block->getRegion();

      if ($variables['base_plugin_id'] === 'system_menu_block') {
        $variables['content']['#attributes']['region'] = $region;
        if ($region === 'sidebar') {
          $variables['#attached']['library'][] = 'apc_brown/menu-sidebar';
        }
      }

      if ($variables['base_plugin_id'] === 'search_form_block') {
        if ($region === 'primary_menu') {
          $variables['#attached']['library'][] = 'apc_brown/search-narrow';
          $variables['content']['actions']['submit']['#theme_wrappers'] = ['input__submit__header_search'];
        }
        elseif ($region === 'secondary_menu') {
          $variables['#attached']['library'][] = 'apc_brown/search-wide';
          $variables['content']['actions']['submit']['#theme_wrappers'] = ['input__submit__header_search'];
        }
      }
    }
  }

  if ($variables['plugin_id'] === 'system_branding_block') {
    $site_branding_color = theme_get_setting('site_branding_bg_color');
    if ($site_branding_color && $site_branding_color !== 'default') {
      $variables['attributes']['class'][] = 'site-branding--bg-' . $site_branding_color;
    }
  }

  // Add a primary-nav class to main menu navigation block.
  if ($variables['plugin_id'] === 'system_menu_block:main') {
    $variables['attributes']['class'][] = 'primary-nav';
  }

  // Every photo_gallery carousel block (homepage and calendar-page mini
  // alike) opens a lightbox on click instead of navigating to the node --
  // the /photos browse page (page_1, not a block) is the one place that
  // outbound link is still the intended behavior. Marked at the
  // block-placement level, not the view/display level all four of these
  // placements share, since that's the only place a block instance is
  // distinguishable from the page display. See photo-carousel.js.
  if (in_array($variables['elements']['#id'] ?? NULL, [
    'apc_brown_calendar_protest_signs_mini',
    'apc_brown_calendar_community_photos_mini',
    'apc_brown_calendar_photos_mobile',
    'apc_brown_photo_gallery_protest_signs',
    'apc_brown_photo_gallery_community_photos',
  ], TRUE)) {
    $variables['attributes']['data-apc-photo-lightbox'] = TRUE;
    $variables['#attached']['library'][] = 'apc_brown/photo-lightbox';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for menu.
 */
function apc_brown_theme_suggestions_menu_alter(&$suggestions, array $variables) {
  if (isset($variables['attributes']['region'])) {
    $suggestions[] = 'menu__' . $variables['attributes']['region'];
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_menu(&$variables) {
  if (isset($variables['attributes']['region'])) {
    if ($variables['attributes']['region'] === 'sidebar') {
      $variables['attributes']['class'][] = 'menu--sidebar';
    }
    unset($variables['attributes']['region']);
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form templates.
 */
function apc_brown_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if ($variables['element']['#form_id'] === 'search_block_form') {
    $suggestions[] = 'form__search_block_form';
  }
}

/**
 * Implements hook_form_alter() for adding classes and placeholder text to the search forms.
 */
function apc_brown_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (isset($form['actions']['submit']) && (count($form['actions'])) <= 2) {
    $form['actions']['submit']['#attributes']['class'][] = 'button--primary';
  }

  switch ($form_id) {
    case 'search_block_form':
      // Add placeholder text to keys input.
      $form['keys']['#attributes']['placeholder'] = t('Search by keyword or phrase.');

      // Add classes to the search form submit input.
      $form['actions']['submit']['#attributes']['class'][] = 'search-form__submit';
      break;

    case 'search_form':
      $form['basic']['keys']['#attributes']['placeholder'] = t('Search by keyword or phrase.');
      $form['basic']['submit']['#attributes']['class'][] = 'button--primary';
      $form['advanced']['submit']['#attributes']['class'][] = 'button--primary';
      break;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block().
 */
function apc_brown_theme_suggestions_block_alter(&$suggestions, array $variables) {
  if (!empty($variables['elements']['#id'])) {

    /** @var \Drupal\block\BlockInterface $block */
    $block = \Drupal::entityTypeManager()
      ->getStorage('block')
      ->load($variables['elements']['#id']);
    if ($block) {

      // Add region-specific block theme suggestions.
      $region = $block
        ->getRegion();

      $suggestions[] = 'block__' . $region;
      $suggestions[] = 'block__' . $region . '__' . 'plugin_id' . '__' . $variables['elements']['#plugin_id'];
      $suggestions[] = 'block__' . $region . '__' . 'id' . '__' . $variables['elements']['#id'];
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu-local-tasks templates.
 */
function apc_brown_preprocess_menu_local_tasks(&$variables) {
  foreach (Element::children($variables['primary']) as $key) {
    $variables['primary'][$key]['#level'] = 'primary';
  }
  foreach (Element::children($variables['secondary']) as $key) {
    $variables['secondary'][$key]['#level'] = 'secondary';
  }
}

/**
 * Implements hook_preprocess_form_element().
 */
function apc_brown_preprocess_form_element(&$variables) {
  if (in_array($variables['element']['#type'] ?? FALSE, ['checkbox', 'radio'], TRUE)) {
    $variables['attributes']['class'][] = 'form-type-boolean';
  }

  if (!empty($variables['description']['attributes'])) {
    $variables['description']['attributes']->addClass('form-item__description');
  }

  if ($variables['disabled']) {
    $variables['label']['#attributes']['class'][] = 'is-disabled';
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_form_element_label(&$variables) {
  $variables['attributes']['class'][] = 'form-item__label';
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_input(&$variables) {
  if (
    !empty($variables['element']['#title_display']) &&
    $variables['element']['#title_display'] === 'attribute' &&
    !empty((string) $variables['element']['#title'])
  ) {
    $variables['attributes']['title'] = (string) $variables['element']['#title'];
  }

  $type_api = $variables['element']['#type'];
  $type_html = $variables['attributes']['type'];
  $text_types_html = [
    'text',
    'email',
    'tel',
    'number',
    'search',
    'password',
    'date',
    'time',
    'file',
    'color',
    'datetime-local',
    'url',
    'month',
    'week',
  ];

  if (in_array($type_html, $text_types_html, TRUE)) {
    $variables['attributes']['class'][] = 'form-element';
    $variables['attributes']['class'][] = Html::getClass('form-element--type-' . $type_html);
    $variables['attributes']['class'][] = Html::getClass('form-element--api-' . $type_api);

    // This logic is functioning as expected, but there is nothing in the theme that renders the result.
    // As a result it can't currently be covered by a functional test.
    if (!empty($variables['element']['#autocomplete_route_name'])) {
      $variables['autocomplete_message'] = t('Loading…');
    }
  }

  if (in_array($type_html, ['checkbox', 'radio'], TRUE)) {
    $variables['attributes']['class'][] = 'form-boolean';
    $variables['attributes']['class'][] = Html::getClass('form-boolean--type-' . $type_html);
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_textarea(&$variables) {
  $variables['attributes']['class'][] = 'form-element';
  $variables['attributes']['class'][] = 'form-element--type-textarea';
  $variables['attributes']['class'][] = 'form-element--api-textarea';
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_select(&$variables) {
  $variables['attributes']['class'][] = 'form-element';
  $variables['attributes']['class'][] = $variables['element']['#multiple'] ?
    'form-element--type-select-multiple' :
    'form-element--type-select';
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_checkboxes(&$variables) {
  $variables['attributes']['class'][] = 'form-boolean-group';
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_radios(&$variables) {
  $variables['attributes']['class'][] = 'form-boolean-group';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for field.html.twig.
 *
 * Targets only field_event_image on the calendar popup's own view mode --
 * the same field on the full event page keeps rendering through the normal
 * formatter/template chain untouched.
 */
function apc_brown_theme_suggestions_field_alter(array &$suggestions, array $variables): void {
  $element = $variables['element'];
  if ($element['#field_name'] === 'field_event_image' && ($element['#view_mode'] ?? '') === 'calendar_item') {
    $suggestions[] = 'field__field_event_image__calendar_item';
  }
  if ($element['#field_name'] === 'field_location_image' && ($element['#view_mode'] ?? '') === 'compact_card') {
    $suggestions[] = 'field__field_location_image__compact_card';
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_field(&$variables) {
  $rich_field_types = ['text_with_summary', 'text', 'text_long'];

  if (in_array($variables['field_type'], $rich_field_types, TRUE)) {
    $variables['attributes']['class'][] = 'text-content';
  }

  if ($variables['field_type'] == 'image' && $variables['element']['#view_mode'] == 'full' && !$variables["element"]["#is_multiple"] && $variables['field_name'] !== 'user_picture') {
    $variables['attributes']['class'][] = 'wide-content';
  }
}

/**
 * Implements hook_preprocess_HOOK() for
 * field--field-event-image--calendar-item.html.twig.
 *
 * Builds the same hero/thumbnail gallery data the full event page uses
 * (_apc_brown_build_gallery(), shared rather than duplicated) from the
 * entity being rendered -- #object is set on every field render element by
 * FormatterBase::view(), so this works regardless of what the field's own
 * configured formatter is.
 *
 * @see _apc_brown_build_gallery()
 * @see \Drupal\apc_calendar\Controller\EventPopupController::popup()
 */
function apc_brown_preprocess_field__field_event_image__calendar_item(&$variables) {
  /** @var \Drupal\Core\Entity\FieldableEntityInterface $entity */
  $entity = $variables['element']['#object'];
  $variables['gallery'] = _apc_brown_build_gallery($entity, 'field_event_image');
}

/**
 * Implements hook_preprocess_HOOK() for
 * field--field-location-image--compact-card.html.twig.
 *
 * The compact_card view mode is only ever used embedded in the calendar
 * event popup (field_location on core.entity_view_display.node.
 * calendar_event.calendar_item.yml) -- same reasoning as the event image
 * override above, just for the location term instead of the node.
 *
 * @see _apc_brown_build_gallery()
 */
function apc_brown_preprocess_field__field_location_image__compact_card(&$variables) {
  /** @var \Drupal\Core\Entity\FieldableEntityInterface $entity */
  $entity = $variables['element']['#object'];
  $variables['gallery'] = _apc_brown_build_gallery($entity, 'field_location_image');
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_field_multiple_value_form(&$variables) {
  // Make disabled available for the template.
  $variables['disabled'] = !empty($variables['element']['#disabled']);

  if (!empty($variables['multiple'])) {
    // Add an additional CSS class for the field label table cell.
    // This repeats the logic of template_preprocess_field_multiple_value_form()
    // without using '#prefix' and '#suffix' for the wrapper element.
    //
    // If the field is multiple, we don't have to check the existence of the
    // table header cell.
    //
    // @see template_preprocess_field_multiple_value_form().
    $header_attributes = ['class' => ['form-item__label', 'form-item__label--multiple-value-form']];
    if (!empty($variables['element']['#required'])) {
      $header_attributes['class'][] = 'js-form-required';
      $header_attributes['class'][] = 'form-required';
    }
    // Using array_key_first() for addressing the first header cell would be
    // more elegant here, but we can rely on the related theme.inc preprocess.
    // @todo change this after https://www.drupal.org/node/3099026 has landed.
    $variables['table']['#header'][0]['data'] = [
      '#type' => 'html_tag',
      '#tag' => 'h4',
      '#value' => $variables['element']['#title'],
      '#attributes' => $header_attributes,
    ];

    if ($variables['disabled']) {
      $variables['table']['#attributes']['class'][] = 'tabledrag-disabled';
      $variables['table']['#attributes']['class'][] = 'js-tabledrag-disabled';

      // We will add the 'is-disabled' CSS class to the disabled table header
      // cells.
      $header_attributes['class'][] = 'is-disabled';
      foreach ($variables['table']['#header'] as &$cell) {
        if (is_array($cell) && isset($cell['data'])) {
          $cell = $cell + ['class' => []];
          $cell['class'][] = 'is-disabled';
        }
        else {
          // We have to modify the structure of this header cell.
          $cell = [
            'data' => $cell,
            'class' => ['is-disabled'],
          ];
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu-local-task templates.
 */
function apc_brown_preprocess_menu_local_task(&$variables) {
  $variables['link']['#options']['attributes']['class'][] = 'tabs__link';
  $variables['link']['#options']['attributes']['class'][] = 'js-tabs-link';

  // Ensure is-active class is set when the tab is active. The generic active
  // link handler applies stricter comparison rules than what is necessary for
  // tabs.
  if (isset($variables['is_active']) && $variables['is_active'] === TRUE) {
    $variables['link']['#options']['attributes']['class'][] = 'is-active';
  }

  if (isset($variables['element']['#level'])) {
    $variables['level'] = $variables['element']['#level'];
  }
}

/**
 * Implements template_preprocess_HOOK() for fieldset.
 */
function apc_brown_preprocess_fieldset(&$variables) {
  $element = $variables['element'];
  $composite_types = ['checkboxes', 'radios'];

  if (!empty($element['#type']) && in_array($element['#type'], $composite_types) && !empty($variables['element']['#children_errors'])) {
    $variables['legend_span']['attributes']->addClass('has-error');
  }

  if (!empty($element['#disabled'])) {
    $variables['legend_span']['attributes']->addClass('is-disabled');

    if (!empty($variables['description']) && !empty($variables['description']['attributes'])) {
      $variables['description']['attributes']->addClass('is-disabled');
    }
  }

  // Remove 'container-inline' class from the main attributes and add a flag
  // instead.
  // @todo remove this after https://www.drupal.org/node/3059593 has been
  //   resolved.
  if (!empty($variables['attributes']['class'])) {
    $container_inline_key = array_search('container-inline', $variables['attributes']['class']);

    if ($container_inline_key !== FALSE) {
      unset($variables['attributes']['class'][$container_inline_key]);
      $variables['inline_items'] = TRUE;
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function apc_brown_theme_suggestions_user_alter(&$suggestions, $variables) {
  $suggestions[] = 'user__' . $variables['elements']['#view_mode'];
}

/**
 * Implements hook_preprocess_HOOK().
 */
function apc_brown_preprocess_field__node__created(&$variables) {
  foreach (Element::children($variables['items']) as $item) {
    unset($variables['items'][$item]['content']['#prefix']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for setting classes.
 */
function apc_brown_preprocess_filter_caption(&$variables) {
  $variables['classes'] = isset($variables['classes']) && !empty($variables['classes']) ? $variables['classes'] . ' caption' : 'caption';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function apc_brown_form_node_preview_form_select_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form['backlink']['#options']['attributes']['class'][] = 'button';
  $form['backlink']['#options']['attributes']['class'][] = 'button--small';
  $form['backlink']['#options']['attributes']['class'][] = 'button--icon-back';
  $form['backlink']['#options']['attributes']['class'][] = 'button--primary';
  $form['view_mode']['#attributes']['class'][] = 'form-element--small';
}

/**
 * Implements hook_preprocess_HOOK() for comment.html.twig.
 */
function apc_brown_preprocess_comment(&$variables) {
  // Getting the node creation time stamp from the comment object.
  $date = $variables['comment']->getCreatedTime();
  // Formatting "created" as "X days ago".
  $variables['created'] = t('@time ago', ['@time' => \Drupal::service('date.formatter')->formatInterval(\Drupal::time()->getRequestTime() - $date)]);
}

/**
 * Implements hook_preprocess_HOOK() for field--comment.html.twig.
 */
function apc_brown_preprocess_field__comment(&$variables) {
  // Add a comment_count.
  $variables['comment_count'] = count(array_filter($variables['comments'], 'is_numeric', ARRAY_FILTER_USE_KEY));

  // Add user.compact to field-comment if profile's avatar of current user
  // exist.
  $user = \Drupal::currentUser();
  if ($user->isAuthenticated() && $user instanceof UserInterface) {
    if ($user->hasField('user_picture') && !$user->get('user_picture')->isEmpty()) {
      $variables['user_picture'] = \Drupal::entityTypeManager()
        ->getViewBuilder('user')
        ->view($user, 'compact');
    }

    $variables['#cache']['contexts'][] = 'user';
  }
}

/**
 * Implements hook_element_info_alter().
 */
function apc_brown_element_info_alter(&$info) {
  if (array_key_exists('text_format', $info)) {
    $info['text_format']['#pre_render'][] = [OliveroPreRender::class, 'textFormat'];
  }

  if (isset($info['status_messages'])) {
    $info['status_messages']['#pre_render'][] = [OliveroPreRender::class, 'messagePlaceholder'];
  }
}

/**
 * Implements template_preprocess_text_format_wrapper().
 *
 * @todo Remove when https://www.drupal.org/node/3016343 is fixed.
 */
function apc_brown_preprocess_text_format_wrapper(&$variables) {
  $description_attributes = [];
  if (!empty($variables['attributes']['id'])) {
    $description_attributes['id'] = $variables['attributes']['aria-describedby'] = $variables['attributes']['id'];
    unset($variables['attributes']['id']);
  }
  $variables['description_attributes'] = new Attribute($description_attributes);
}

/**
 * Implements hook_preprocess_search_result().
 */
function apc_brown_preprocess_search_result(&$variables) {
  // Apply custom date formatter to "date" field.
  if (!empty($variables['result']['date'])) {
    $variables['info_date'] = \Drupal::service('date.formatter')->format($variables['result']['node']->getCreatedTime(), 'apc_brown_medium');
  }
}

/**
 * Implements hook_preprocess_item_list__search_results().
 */
function apc_brown_preprocess_item_list__search_results(&$variables) {
  if (isset($variables['empty'])) {
    $variables['empty']['#attributes']['class'][] = 'empty-search-results-text';
    $variables['empty']['#attached']['library'][] = 'apc_brown/search-results';
  }
}

/**
 * Implements hook_preprocess_links__comment().
 */
function apc_brown_preprocess_links__comment(&$variables) {
  foreach ($variables['links'] as &$link) {
    $link['link']['#options']['attributes']['class'][] = 'comment__links-link';
  }
}

/**
 * Implements hook_preprocess_table().
 */
function apc_brown_preprocess_table(&$variables) {
  // Mark the whole table and the first cells if rows are draggable.
  if (!empty($variables['rows'])) {
    $draggable_row_found = FALSE;
    foreach ($variables['rows'] as &$row) {
      /** @var \Drupal\Core\Template\Attribute $row['attributes'] */
      if (!empty($row['attributes']) && $row['attributes']->hasClass('draggable')) {
        if (!$draggable_row_found) {
          $variables['attributes']['class'][] = 'draggable-table';
          $draggable_row_found = TRUE;
        }
      }
    }
  }
}

/**
 * Implements hook_form_views_exposed_form_alter().
 */
function apc_brown_form_views_exposed_form_alter(&$form) {
  $form['#attributes']['class'][] = 'form--inline';
}

/**
 * Implements hook_preprocess_HOOK() for views-view.html.twig.
 */
function apc_brown_preprocess_views_view(&$variables) {
  // Every block display of the photo_gallery view is a shuffle-and-cycle
  // carousel (see photo-gallery-specs.md, "Why client-side shuffle, not
  // server-side random") -- matched by display ID prefix rather than an
  // enumerated list so a future block (e.g. "Volunteer") picks this up with
  // no code change, just a new block display. The page_1 browse display is
  // deliberately excluded: it's a plain paged grid, not a carousel.
  $view = $variables['view'];

  // /calendar has no visible page title -- the generic "Page title" block is
  // hidden there (block.block.apc_brown_page_title) so the calendar sits as
  // high on the page as possible -- which left the page with no <h1> at all
  // (bad for screen-reader navigation and SEO). Supply one, visually hidden,
  // so it costs no vertical space. Printed via title_prefix, which
  // views-view.html.twig always outputs (unlike `title`, which is admin-preview
  // only).
  if ($view->id() === 'calendar' && $view->current_display === 'page_1') {
    $variables['title_prefix']['apc_calendar_h1'] = [
      '#type' => 'html_tag',
      '#tag' => 'h1',
      '#value' => t('Event calendar'),
      '#attributes' => ['class' => ['visually-hidden']],
      '#weight' => -100,
    ];
  }
  if ($view->id() === 'photo_gallery') {
    // Card/grid CSS is shared by every display (including page_1's plain
    // browse grid); the carousel behavior itself only activates JS-side for
    // elements carrying the data attribute below, so attaching this on
    // page_1 too is harmless -- photo-carousel.js finds nothing to do.
    $variables['#attached']['library'][] = 'apc_brown/photo-carousel';
    if (str_starts_with($view->current_display, 'block_')) {
      $variables['attributes']['data-apc-photo-carousel'] = TRUE;
    }
    // The /photos browse grid (page_1) opens the same lightbox on click as
    // the carousels, rather than navigating to the bare node view -- the
    // grid variant of photo-lightbox.js keys off this attribute.
    elseif ($view->current_display === 'page_1') {
      $variables['attributes']['data-apc-photo-grid'] = TRUE;
      $variables['#attached']['library'][] = 'apc_brown/photo-lightbox';
      $variables['#attached']['library'][] = 'apc_brown/disable-views-scroll-top';
      $variables['#attached']['library'][] = 'apc_brown/photo-filters';
    }
    // The wall (wall_recent_all, embedded on the homepage and the
    // /calendar/upcoming sidebar) is the same kind of plain grid, but opens
    // the simpler single-image apc_brown/lightbox instead -- picked on
    // request for a more consistent feel with the homepage hero's own
    // lightbox, rather than the carousels'/page_1's richer prev/next +
    // caption one. See js/wall-lightbox.js.
    elseif ($view->current_display === 'wall_recent_all') {
      $variables['attributes']['data-apc-wall-lightbox'] = TRUE;
      $variables['#attached']['library'][] = 'apc_brown/wall-lightbox';
    }

    // Per-photo data for the richer lightbox (apc_brown/photo-lightbox):
    // the original uncropped image, plus caption/credit -- none of which
    // the Views-rendered card markup exposes. Its own <img> is the cropped
    // photo_gallery_card style, and entity_reference_entity_view bypasses
    // field.html.twig entirely (Views' "Rendered entity" field renders the
    // referenced entity directly), so there's no per-field template hook to
    // hang data-* attributes off of either. Keyed by nid so photo-carousel.js
    // can look a slide up from the nid already in its node/[nid] link.
    // Attached even on page_1 (not lightbox-enabled) -- unused JSON in
    // drupalSettings, no real cost, and simpler than duplicating this loop
    // per display.
    $lightbox_data = [];
    $cache_tags = [];
    foreach ($view->result as $row) {
      $node = $row->_entity ?? NULL;
      if (!$node instanceof NodeInterface || !$node->hasField('field_photo_image') || $node->get('field_photo_image')->isEmpty()) {
        continue;
      }
      $cache_tags = Cache::mergeTags($cache_tags, $node->getCacheTags());

      $media = $node->get('field_photo_image')->entity;
      if ($media === NULL || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
        continue;
      }
      $image_item = $media->get('field_media_image')->first();
      $file = $image_item->entity;
      if ($file === NULL) {
        continue;
      }

      $entry = [
        'full' => \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri()),
        'alt' => $image_item->get('alt')->getString() ?: $media->label(),
        'caption' => $node->hasField('field_caption') ? (string) $node->get('field_caption')->value : '',
      ];
      // Only ever include a name when the submitter opted into public
      // credit -- field_credit_publicly exists precisely to gate this.
      if ($node->hasField('field_credit_publicly') && $node->get('field_credit_publicly')->value && $node->hasField('field_submitter_name')) {
        $submitter = trim((string) $node->get('field_submitter_name')->value);
        if ($submitter !== '') {
          $entry['credit'] = $submitter;
        }
      }

      // The lightbox shows this "full" entry uncropped (no image style --
      // see the comment on _apc_brown_build_gallery()'s identical choice),
      // so photo-lightbox.js's own default-zoom-on-desktop feature has
      // nothing but the raw image to work with. Confirmed live: with no
      // hint at all it defaulted to scrolling the zoomed view to the
      // image's top-left corner, which on a tall multi-panel photo (a
      // common shape for a submitted screenshot/meme) could land anywhere
      // relative to the actual subject -- reads as "randomly zooming".
      // Every image on the site already gets a focal point one way or
      // another (explicitly set via the crosshair widget, or the
      // focal_point.settings.default_value fallback applied at media save
      // -- see apc_calendar.module/Group 4 notes), so reusing that same
      // point to center the default zoom on is the same "where's the
      // interesting part" answer the site's other focal-point-aware crops
      // already give, just applied to an uncropped image instead of a
      // fixed box.
      $width = (int) ($image_item->width ?? 0);
      $height = (int) ($image_item->height ?? 0);
      if ($width && $height) {
        $focal_point_manager = \Drupal::service('focal_point.manager');
        $position = $focal_point_manager->getCropEntity($file, 'focal_point')->position();
        $entry['focalPoint'] = $focal_point_manager->absoluteToRelative($position['x'], $position['y'], $width, $height);
      }

      $lightbox_data[$node->id()] = $entry;
    }
    if ($lightbox_data) {
      $variables['#attached']['drupalSettings']['apcPhotoGallery'] = $lightbox_data;
      $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $cache_tags);
    }
  }

  // See calendar-filter.js's file header for why this can't reuse Views'
  // own AJAX handling the way the photo_gallery filters do.
  if ($view->id() === 'calendar' && $view->current_display === 'page_1') {
    $variables['#attached']['library'][] = 'apc_brown/calendar-filter';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view-field.html.twig.
 *
 * photo_gallery's field_photo_image link is built entirely by Views' own
 * alter->make_link (link_class: apc-photo-gallery__photo), not a template
 * this module can add attributes to normally -- so wall-lightbox.js,
 * photo-lightbox.js and photo-carousel.js all used to pull the node id back
 * out of that link's own href with a regex instead (it used to always be
 * node/[nid]). That broke the moment community_photo nodes got their own
 * /photos/[title] alias (pathauto.pattern.community_photos) -- an alias
 * carries no nid at all, so the regex found nothing and each of those three
 * behaviors either silently fell back to a smaller/uncropped image or (in
 * wall-lightbox.js's case) let the click fall through to a real page
 * navigation instead of opening the lightbox. Stamping the nid on as its own
 * data attribute here means those scripts no longer depend on the URL's
 * shape at all.
 */
function apc_brown_preprocess_views_view_field(&$variables) {
  $field = $variables['field'] ?? NULL;
  if (!$field || $variables['view']->id() !== 'photo_gallery' || $field->field !== 'field_photo_image') {
    return;
  }
  $node = $variables['row']->_entity ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  // Views renders this field's link as a plain HTML string (no render array
  // to attach #attributes to at this point), so the attribute is spliced
  // into the opening tag directly. Safe because the tag is always Drupal
  // core's own Link::toString() output, which always starts "<a ".
  $variables['output'] = Markup::create(preg_replace(
    '/<a /',
    '<a data-photo-nid="' . $node->id() . '" ',
    (string) $variables['output'],
    1
  ));
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view_fields.
 *
 * Scopes a fields-row template override to the photo_gallery view, so the
 * /photos grid can append an admin-only View/Edit row per row without
 * touching the base views-view-fields template site-wide. The template is
 * shared by this view's carousel blocks too, but they never get the
 * admin_links variable (see apc_brown_preprocess_views_view_fields), so they
 * render exactly as before.
 */
function apc_brown_theme_suggestions_views_view_fields_alter(array &$suggestions, array $variables): void {
  $view = $variables['view'] ?? NULL;
  if ($view && $view->id() === 'photo_gallery') {
    $suggestions[] = 'views_view_fields__photo_gallery';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views-view-fields.html.twig.
 *
 * Adds an admin-only "View / Edit" action row to each /photos browse-grid
 * row. Gated on the viewer's node update access -- so it is genuinely
 * access-controlled, not merely CSS-hidden, and never renders for anonymous
 * visitors -- and scoped to the page_1 display (the caption/photo already
 * link out for everyone; this is the reviewer's shortcut to the node itself,
 * which the media contextual-links pencil doesn't reach). The two link
 * targets, unlike that pencil, are the community_photo node: its canonical
 * view and its edit form.
 */
function apc_brown_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'];
  if ($view->id() !== 'photo_gallery' || $view->current_display !== 'page_1') {
    return;
  }
  $node = $variables['row']->_entity ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }

  // Visibility varies per viewer (edit access), so make that explicit on the
  // render array -- a row cached for an editor must never be reused for an
  // anonymous visitor.
  $variables['#cache']['contexts'][] = 'user.permissions';
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $node->getCacheTags());

  if (!$node->access('update')) {
    return;
  }

  // Return to the exact /photos state (filters, page) after an edit.
  $destination = \Drupal::request()->getRequestUri();
  $variables['admin_links'] = [
    '#theme' => 'links',
    '#attributes' => ['class' => ['apc-photo-gallery__admin']],
    '#links' => [
      'view' => [
        'title' => t('View node'),
        'url' => $node->toUrl(),
      ],
      'edit' => [
        'title' => t('Edit node'),
        'url' => $node->toUrl('edit-form', ['query' => ['destination' => $destination]]),
      ],
    ],
  ];
}

/**
 * Converts hex color strings to array of HSL values.
 *
 * @param string $hex_string
 *   The 6-character hexadecimal color code, optionally with a leading hash
 *
 * @return array
 *   Array containing hue, saturation, and lightness values.
 *   $hue: integer of value 0-360 indicating the hue on a color wheel.
 *   $saturation: string of saturation as a percentage (0% all gray, 100% full color).
 *   $lightness: string of lightness as a percentage (0% darkened to black, 50% full color, 100% lightened to white).
 *
 * @see https://css-tricks.com/converting-color-spaces-in-javascript
 *   Code based on JS version.
 * @see https://www.rapidtables.com/convert/color/rgb-to-hsl.html
 *   Mathematical formula for rgb-to-hsl conversion.
 *
 * @internal
 */
function _apc_brown_hex_to_hsl(string $hex_string) {
  // Convert hexcode pairs to rgb values (0-255).
  $hex_val = trim($hex_string, '#');

  $r0 = $g0 = $b0 = '00';

  if (strlen($hex_val) === 6) {
    $r0 = hexdec($hex_val[0] . $hex_val[1]);
    $g0 = hexdec($hex_val[2] . $hex_val[3]);
    $b0 = hexdec($hex_val[4] . $hex_val[5]);
  }

  if (strlen($hex_val) === 3) {
    $r0 = hexdec($hex_val[0] . $hex_val[0]);
    $g0 = hexdec($hex_val[1] . $hex_val[1]);
    $b0 = hexdec($hex_val[2] . $hex_val[2]);
  }

  // Convert rgb's 0-255 to decimal values.
  $r = fdiv($r0, 255);
  $g = fdiv($g0, 255);
  $b = fdiv($b0, 255);

  // Calculate Hue.
  $c_min = min($r, $g, $b);
  $c_max = max($r, $g, $b);
  $delta = $c_max - $c_min;

  if ($delta == 0) {
    $h = 0;
  }
  else {
    switch ($c_max) {
      case $r:
        $h = fmod((($g - $b) / $delta), 6);
        break;

      case $g:
        $h = (($b - $r) / $delta) + 2;
        break;

      case $b:
        $h = (($r - $g) / $delta) + 4;
        break;

      default:
        $h = 0;
        break;
    }
  }

  $h = round($h * 60);

  // Shift hue range from [-60 - 300] to [0 - 360].
  if ($h < 0) {
    $h += 360;
  }

  // Calculate Lightness.
  $l = ($c_max + $c_min) / 2;

  // Calculate Saturation.
  $s = $delta == 0 ? 0 : $delta / (1 - abs((2 * $l) - 1));

  // Convert Saturation and Lightness to percentages.
  $s = round($s * 100);
  $l = round($l * 100);

  return [$h, $s, $l];
}
