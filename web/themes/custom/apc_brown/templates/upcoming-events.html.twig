{#
/**
 * @file
 * Plain chronological "browse upcoming events" page (/calendar/upcoming).
 *
 * cards are pre-rendered render arrays (calendar_item view mode, narrowed
 * to the specific occurrence that matched, each already wired to open the
 * same AJAX popup dialog /calendar uses) -- see
 * UpcomingEventsController::build() and EventCardBuilder::renderOccurrence().
 * signs_sidebar and recent_posts are built in
 * apc_brown_preprocess_apc_upcoming_events().
 *
 * @see \Drupal\apc_calendar\Controller\UpcomingEventsController
 * @see apc_brown_preprocess_apc_upcoming_events()
 */
#}
<div class="apc-upcoming">

  <div class="apc-upcoming__layout">
    <div class="apc-upcoming__main">
      <div class="apc-upcoming__head">
        <h1 class="apc-upcoming__title">{{ heading ?: 'Upcoming events'|t }}</h1>
        {# Phones never see this: /calendar sends them here, and a month grid
           doesn't fit their screen (hidden by CSS at the same 768px). #}
        <a class="apc-upcoming__month-link" href="{{ path('view.calendar.page_1') }}">{{ 'Month view'|t }} &rarr;</a>
      </div>

      {# Collapsed by default so the list is the first thing on a phone; the
         summary line says what is applied while it is shut. Plain GET form:
         every filtered view is a normal, bookmarkable URL. The category
         dropdown submits itself (upcoming-filter.js); the dates wait for
         "Apply" because a half-typed date must not fire a request. #}
      <details class="apc-upcoming__filters">
        <summary class="apc-upcoming__filters-toggle">
          <span class="apc-upcoming__filters-label">{{ 'Filter by date or category'|t }}</span>
          {% if filter.active %}
            <span class="apc-upcoming__filters-state">{{ filter.description }}</span>
          {% endif %}
        </summary>

        <form class="apc-upcoming__filter" method="get" action="{{ path('apc_calendar.upcoming_events') }}">
          <div class="apc-upcoming__filter-dates">
            <div class="apc-upcoming__field">
              <label class="apc-upcoming__label" for="apc-upcoming-from">{{ 'From'|t }}</label>
              <input class="apc-upcoming__control" type="date" id="apc-upcoming-from" name="from" value="{{ filter.from }}">
            </div>
            <div class="apc-upcoming__field">
              <label class="apc-upcoming__label" for="apc-upcoming-to">{{ 'To'|t }}</label>
              <input class="apc-upcoming__control" type="date" id="apc-upcoming-to" name="to" value="{{ filter.to }}" {% if filter.from %}min="{{ filter.from }}"{% endif %}>
            </div>
          </div>

          {% if filter.options %}
            <div class="apc-upcoming__field">
              <label class="apc-upcoming__label" for="apc-upcoming-tag">{{ 'Category'|t }}</label>
              <select id="apc-upcoming-tag" name="tag" class="apc-upcoming__control apc-upcoming__filter-select">
                <option value="">{{ '- Any -'|t }}</option>
                {% for option in filter.options %}
                  <option value="{{ option.tid }}"{% if option.tid == filter.selected %} selected{% endif %}>{{ option.label }} ({{ option.count }})</option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          <div class="apc-upcoming__filter-actions">
            <button type="submit" class="button button--primary apc-upcoming__apply">{{ 'Apply'|t }}</button>
          </div>
        </form>
      </details>

      {% if summary %}
        <p class="apc-upcoming__summary">
          {{ summary }}
          {% if filter.active %}
            <a class="apc-upcoming__clear" href="{{ path('apc_calendar.upcoming_events') }}">{{ 'Clear filters'|t }}</a>
          {% endif %}
        </p>
      {% endif %}

      {% if cards %}
        <div class="apc-upcoming__grid">
          {% for card in cards %}
            <div class="apc-upcoming__card">{{ card }}</div>
          {% endfor %}
        </div>
        {{ pager }}
      {% elseif filter.active %}
        <p>{{ 'No events match these filters.'|t }} <a href="{{ path('apc_calendar.upcoming_events') }}">{{ 'Clear filters'|t }}</a></p>
      {% else %}
        <p>{{ 'No upcoming events right now -- check back soon.'|t }}</p>
      {% endif %}
    </div>

    <aside class="apc-upcoming__sidebar">
      {% if signs_sidebar %}
        <section class="apc-upcoming__sidebar-box">
          <h2 class="apc-upcoming__sidebar-heading">{{ 'Signs & photos'|t }}</h2>
          {{ signs_sidebar }}
          <a class="apc-front__more-link" href="/photos">{{ 'See the full wall of signs'|t }} &rarr;</a>
        </section>
      {% endif %}

      {% if recent_posts %}
        <section class="apc-upcoming__sidebar-box">
          <h2 class="apc-upcoming__sidebar-heading">{{ 'Recent posts'|t }}</h2>
          {{ recent_posts }}
          <a class="apc-front__more-link" href="/blog">{{ 'See all posts'|t }} &rarr;</a>
        </section>
      {% endif %}
    </aside>
  </div>

</div>
