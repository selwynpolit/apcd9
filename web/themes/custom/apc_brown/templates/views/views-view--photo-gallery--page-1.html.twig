{#
/**
 * @file
 * Theme override for the Photo Gallery browse page (views.view.photo_gallery,
 * display page_1 -- NOT the block_community_photos/block_protest_signs
 * carousels, which keep the base views-view.html.twig markup unchanged).
 *
 * Puts the title, "Upload a photo, meme or sign" CTA (the view's header area) and
 * the exposed filters (Category / Photo or sign? / Reset) into one left-hand
 * column, with the results grid to its right -- the same page previously
 * stacked all of that full-width above the grid, which read as an oversized
 * header eating most of the viewport before any photos appeared.
 *
 * apc_brown_page_title's generic "Page title" block is hidden on /photos
 * (see block.block.apc_brown_page_title.yml) so the sidebar can carry its
 * own heading instead of a full-width title appearing above this whole
 * view, same as it's hidden on /calendar/* and /locations/* for their own
 * bespoke templates. The heading text below is hardcoded rather than
 * printed from the `title` variable: confirmed live that `title` is only
 * populated for Views UI/attachment preview rendering, not for a real page
 * display -- template_preprocess_views_view()'s own doc comment says as
 * much ("Title of the view, only used when displaying in the admin
 * preview"). Keep this in sync with page_1's "title" setting in
 * views.view.photo_gallery.yml if that's ever changed. */
 *
 * @see views-view.html.twig
 * @see template_preprocess_views_view()
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  <div class="apc-photo-gallery__layout">
    <aside class="apc-photo-gallery__sidebar">
      {{ title_prefix }}
      <h1 class="apc-photo-gallery__title">{{ 'Photo Gallery'|t }}</h1>
      {{ title_suffix }}
      {% if header %}
        <div class="view-header">
          {{ header }}
        </div>
      {% endif %}
      {% if exposed %}
        {# Collapsible below 62.5rem, where the filters otherwise push the
           photos several screens down; always open (summary hidden) above
           it. Closed in the markup, opened by CSS/JS at desktop width --
           see photo-filters.js. #}
        <details class="apc-photo-gallery__filters" data-apc-photo-filters>
          <summary class="apc-photo-gallery__filters-toggle">
            <span>{{ 'Filters'|t }}</span>
            <span class="apc-photo-gallery__filters-count" data-apc-filter-count></span>
          </summary>
          <div class="view-filters">
            {{ exposed }}
          </div>
        </details>
      {% endif %}
    </aside>

    <div class="apc-photo-gallery__main">
      {% if attachment_before %}
        <div class="attachment attachment-before">
          {{ attachment_before }}
        </div>
      {% endif %}

      {% if rows %}
        <div class="view-content">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="view-empty">
          {{ empty }}
        </div>
      {% endif %}

      {% if pager %}
        {{ pager }}
      {% endif %}
      {% if attachment_after %}
        <div class="attachment attachment-after">
          {{ attachment_after }}
        </div>
      {% endif %}
      {% if more %}
        {{ more }}
      {% endif %}
      {% if footer %}
        <div class="view-footer">
          {{ footer }}
        </div>
      {% endif %}
      {% if feed_icons %}
        <div class="feed-icons">
          {{ feed_icons }}
        </div>
      {% endif %}
    </div>
  </div>
</div>
