/**
 * Implements hook_ENTITY_TYPE_presave() for taxonomy_term entities.
 *
 * Locations terms auto-created by anonymous event submitters are saved
 * unpublished so they stay out of the reference autocomplete (core's
 * TermSelection::buildEntityQuery() filters on status for non-admins) and off
 * the public term page until an admin publishes them.
 *
 * Gated on the 'bypass location approval' permission rather than
 * !isAnonymous(). Until the event_contributor/event_manager roles existed,
 * every authenticated user was a known, accountable person, so gating on
 * anonymity alone was equivalent and simpler. That stopped being true the
 * moment a role meant to be handed out more freely (event_contributor)
 * existed — a permission check is what keeps a future low-trust or
 * self-registered role from silently inheriting instant-publish. Currently
 * granted to event_contributor and event_manager (administrator has every
 * permission implicitly via is_admin).
 *
 * Also forces an initial capital on term names in the locations and tags
 * vocabularies, so "burger king" and "Burger King" don't end up as two
 * different terms depending on who typed which one first. Runs on every
 * save, not just new terms, so a later edit gets normalized too.
 * Unicode::ucfirst() rather than PHP's ucfirst(), which is byte-oriented and
 * would corrupt a multibyte leading character (e.g. an accented venue name).
 * No exception is carved out for deliberately-lowercase names ("eBay",
 * "danceAustin") — not worth the added complexity for how rarely it comes
 * up here.
 */
function apc_calendar_taxonomy_term_presave(TermInterface $term): void {
  // Fill in author name.
  if ($term->bundle() === 'locations') {
    if ($term->get('field_term_author')->isEmpty()) {
      $term->set('field_term_author', \Drupal::currentUser()->id());
    }
  }

  // Set unpublished for anonymous users. Photo Categories uses the same
  // gate as Locations (a new term anyone can type, but only trusted roles
  // skip the review queue) -- see photo-gallery-specs.md, "Why not reuse
  // tags": the vocabularies share this moderation shape but stay separate so
  // an event-tag admin screen never picks up photo-only terms or vice versa.
  if ($term->isNew() && $term->bundle() === 'locations') {
    if (!\Drupal::currentUser()->hasPermission('bypass location approval')) {
      $term->setUnpublished();
    }
   }
  if ($term->isNew() && $term->bundle() === 'photo_categories') {
    if (!\Drupal::currentUser()->hasPermission('bypass photo category approval')) {
      $term->setUnpublished();
    }
  }

  // Strip stray leading/trailing whitespace and force an initial capital on
  // the term name. The trim matters beyond cosmetics: a leading space sorts
  // before every letter under this column's collation, so a term saved with
  // one silently floats to the top of any alphabetical listing regardless
  // of what letter its name actually starts with (see the Tag Keywords view
  // and apc_calendar_update_10004(), which cleans up names that predate
  // this guard).
  if (in_array($term->bundle(), ['locations', 'tags', 'photo_categories'], TRUE)) {
    $name = trim((string) $term->getName());
    if ($name !== '') {
      $term->setName(Unicode::ucfirst($name));
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_term_tags_form.
 *
 * Enforces the same ASCII-only requirement TagMapSettingsForm used to
 * enforce on the YAML map, now that field_tag_keywords/
 * field_tag_exclude_keywords live on the term itself.
 * TagSuggester::anyPhraseMatches() deliberately does not use the /u (UTF-8)
 * regex modifier -- \b's simpler, non-Unicode semantics are only safe to
 * rely on if keywords are guaranteed ASCII.
 *
 * @see \Drupal\apc_calendar\TagSuggester
 */
function apc_calendar_form_taxonomy_term_tags_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#validate'][] = 'apc_calendar_validate_tag_keywords_ascii';
}

/**
 * Form validation handler: keywords must be ASCII.
 *
 * @see apc_calendar_form_taxonomy_term_tags_form_alter()
 */
function apc_calendar_validate_tag_keywords_ascii(array &$form, FormStateInterface $form_state): void {
  foreach (['field_tag_keywords', 'field_tag_exclude_keywords'] as $field_name) {
    if (!isset($form[$field_name])) {
      continue;
    }
    foreach ($form_state->getValue($field_name) ?? [] as $delta => $item) {
      // $form_state's raw values for a multi-value widget include an
      // 'add_more' entry alongside the numeric deltas -- the "Add another
      // item" button's own value, not a keyword row. Core's own
      // WidgetBase::extractFormValues() unsets the same key for the same
      // reason before treating the rest as delta => value pairs.
      if (!is_array($item)) {
        continue;
      }
      $value = trim((string) ($item['value'] ?? ''));
      if ($value !== '' && preg_match('/[^\x00-\x7F]/', $value) === 1) {
        $form_state->setError(
          $form[$field_name]['widget'][$delta]['value'],
          t('Keep keywords ASCII: "%value" is not.', ['%value' => $value])
        );
      }
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_term_locations_form.
 *
 * Adds "Find on Google Maps" / "Find on OpenStreetMap" links so an admin
 * repairing a location with no address can locate the venue without leaving
 * the form. Deliberately static links computed from the term's current
 * saved values, not the in-progress form input — no AJAX, no geocoder call,
 * nothing that can fail or hit the geocoder's rate limit just from opening
 * this form.
 *
 * @see apc_calendar_build_directions()
 */
function apc_calendar_form_taxonomy_term_locations_form_alter(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $form_state->getFormObject()->getEntity();

  $query = $term->label();
  $locality = NULL;
  $administrative_area = NULL;
  if ($term->hasField('field_address') && !$term->get('field_address')->isEmpty()) {
    $address = $term->get('field_address')->first();
    $locality = $address->get('locality')->getValue();
    $administrative_area = $address->get('administrative_area')->getValue();
  }
  // Bare venue names are ambiguous worldwide -- put a city in the query even
  // when the term has no address yet, same reasoning as
  // apc_calendar_build_directions() preferring an unambiguous destination.
  $query .= ' ' . (($locality || $administrative_area) ? trim($locality . ' ' . $administrative_area) : 'Austin TX');
  $encoded = rawurlencode($query);

  $form['apc_map_search'] = [
    '#type' => 'container',
    '#weight' => -1,
    '#attributes' => ['class' => ['apc-map-search']],
    'label' => [
      '#type' => 'html_tag',
      '#tag' => 'span',
      '#value' => t('Find this venue:'),
    ],
    'google' => [
      '#type' => 'link',
      '#title' => t('Google Maps'),
      '#url' => Url::fromUri('https://www.google.com/maps/search/?api=1&query=' . $encoded),
      '#attributes' => ['target' => '_blank', 'rel' => 'noopener noreferrer'],
    ],
    'osm' => [
      '#type' => 'link',
      '#title' => t('OpenStreetMap'),
      '#url' => Url::fromUri('https://www.openstreetmap.org/search?query=' . $encoded),
      '#attributes' => ['target' => '_blank', 'rel' => 'noopener noreferrer'],
    ],
  ];

  // Paste-box geocoder: accepts either coordinates (copied from the Maps
  // link above) or an address string, looks it up via Nominatim, and shows
  // a read-only preview. "Apply" is a genuine form submit rather than an
  // AJAX widget update -- the Address field and Geofield widgets each have
  // their own internal format (a composite element and a GeoJSON textarea
  // respectively), and injecting values past those correctly is fragile.
  // Routing through $form_state->setValueForElement() and letting
  // TermForm's own save cycle run afterward is simpler and also means
  // whatever else the admin has already typed elsewhere on the form is
  // saved together with the geocoded address, not discarded.
  $form['apc_geocode'] = [
    '#type' => 'fieldset',
    '#title' => t('Look up an address or coordinates'),
    '#weight' => 0,
    '#tree' => TRUE,
    '#prefix' => '<div id="apc-geocode-wrapper">',
    '#suffix' => '</div>',
  ];
  $form['apc_geocode']['input'] = [
    '#type' => 'textfield',
    '#title' => t('Paste coordinates or an address'),
    '#description' => t('Paste a lat,lon pair copied from Google Maps (e.g. 30.2903, -97.7000), or an address string.'),
  ];
  $form['apc_geocode']['lookup'] = [
    '#type' => 'submit',
    '#value' => t('Look up'),
    '#name' => 'apc_geocode_lookup',
    '#submit' => ['apc_calendar_geocode_lookup_submit'],
    '#ajax' => [
      'callback' => 'apc_calendar_geocode_lookup_ajax',
      'wrapper' => 'apc-geocode-wrapper',
    ],
    '#limit_validation_errors' => [['apc_geocode', 'input']],
  ];

  $candidates = $form_state->get('apc_geocode_candidates');
  if ($candidates) {
    $form['apc_geocode']['result'] = [
      '#type' => 'container',
    ];
    if (count($candidates) === 1) {
      $form['apc_geocode']['result']['summary'] = [
        '#type' => 'html_tag',
        '#tag' => 'p',
        '#value' => t('Found: @summary', ['@summary' => $candidates[0]['summary']]),
      ];
      $form['apc_geocode']['result']['selected'] = [
        '#type' => 'value',
        '#value' => 0,
      ];
    }
    else {
      $form['apc_geocode']['result']['selected'] = [
        '#type' => 'radios',
        '#title' => t('Multiple matches -- pick the right one'),
        '#options' => array_map(static fn (array $c) => $c['summary'], $candidates),
        '#default_value' => 0,
      ];
    }
    $form['apc_geocode']['result']['apply'] = [
      '#type' => 'submit',
      '#value' => t('Apply to address fields'),
      '#name' => 'apc_geocode_apply',
      '#submit' => ['apc_calendar_geocode_apply_submit'],
      '#limit_validation_errors' => [['apc_geocode', 'result', 'selected']],
    ];
  }
  elseif ($form_state->get('apc_geocode_error')) {
    $form['apc_geocode']['error'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['apc-geocode-error']],
      '#value' => $form_state->get('apc_geocode_error'),
    ];
  }

  // Stop the geofield's Leaflet map from swallowing the page scroll. The
  // leaflet_widget's scroll_zoom_enabled:0 setting does NOT actually disable
  // wheel zoom -- its JS only wires focus/blur toggling when the setting is
  // ON, and otherwise leaves Leaflet's built-in default (wheel zoom enabled).
  // So we disable it client-side instead; the +/- buttons still zoom the map.
  $form['#attached']['library'][] = 'apc_calendar/leaflet_no_scroll_zoom';
}

/**
 * Submit handler for the "Look up" button.
 *
 * @see apc_calendar_form_taxonomy_term_locations_form_alter()
 */
function apc_calendar_geocode_lookup_submit(array &$form, FormStateInterface $form_state): void {
  $form_state->set('apc_geocode_candidates', NULL);
  $form_state->set('apc_geocode_error', NULL);

  $input = trim((string) $form_state->getValue(['apc_geocode', 'input']));
  if ($input === '') {
    $form_state->set('apc_geocode_error', t('Paste an address or a lat,lon pair first.'));
    $form_state->setRebuild(TRUE);
    return;
  }

  $geocoder = \Drupal::service('geocoder');

  // Coordinate pair: two floats separated by a comma, e.g. "30.29, -97.70".
  if (preg_match('/^(-?\d+\.?\d*)\s*,\s*(-?\d+\.?\d*)$/', $input, $matches)) {
    $lat = $matches[1];
    $lon = $matches[2];
    $collection = $geocoder->reverse($lat, $lon, ['nominatim']);
    $pasted_coordinates = ['lat' => (float) $lat, 'lon' => (float) $lon];
  }
  else {
    $collection = $geocoder->geocode($input, ['nominatim']);
    $pasted_coordinates = NULL;
  }

  if ($collection === NULL || $collection->isEmpty()) {
    $form_state->set('apc_geocode_error', t('No results for that. Check the spelling, or paste coordinates instead.'));
    $form_state->setRebuild(TRUE);
    return;
  }

  $candidates = [];
  foreach ($collection as $address) {
    $candidates[] = _apc_calendar_normalize_geocoder_address($address, $pasted_coordinates);
  }
  $form_state->set('apc_geocode_candidates', $candidates);
  $form_state->setRebuild(TRUE);
}

/**
 * AJAX callback for the "Look up" button.
 *
 * @see apc_calendar_form_taxonomy_term_locations_form_alter()
 */
function apc_calendar_geocode_lookup_ajax(array &$form, FormStateInterface $form_state): array {
  return $form['apc_geocode'];
}

/**
 * Submit handler for "Apply to address fields".
 *
 * Saves field_address and field_geofield immediately and redirects back to
 * this same edit page, rather than trying to make the rebuilt form's
 * widgets display the new values in memory before a save.
 *
 * That in-memory approach was tried first and did not work reliably:
 * $form_state->setValueForElement() only changes what a later submit
 * handler reads, not what a rebuilt widget displays (widgets rebuild their
 * displayed value from the form's entity, not from $form_state's values),
 * and setting the values directly on the form's (still unsaved) entity
 * before calling $form_state->setRebuild(TRUE) also did not reliably
 * redisplay them -- both the Address field (a composite element) and
 * Geofield (a GeoJSON textarea widget with its own map-refresh behaviour)
 * have enough of their own internal state that an in-memory rebuild was
 * not trustworthy. A real save followed by a normal fresh page load always
 * shows correct widget state, because that is the one path every field
 * widget is guaranteed to get right.
 *
 * This does mean other fields the admin was mid-editing (name, notes,
 * image, tags) are not part of this intermediate save -- they stay in the
 * form for the admin to submit normally afterward, not lost, just not
 * saved by this button.
 *
 * @see apc_calendar_form_taxonomy_term_locations_form_alter()
 */
function apc_calendar_geocode_apply_submit(array &$form, FormStateInterface $form_state): void {
  $candidates = $form_state->get('apc_geocode_candidates');
  $selected = $form_state->getValue(['apc_geocode', 'result', 'selected']);
  $candidate = $candidates[$selected] ?? NULL;
  if ($candidate === NULL) {
    return;
  }

  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $form_state->getFormObject()->getEntity();
  $term->set('field_address', $candidate['address']);
  $term->set('field_geofield', $candidate['geofield_value']);
  $term->save();

  \Drupal::messenger()->addStatus(t('Address and coordinates saved. Review the fields below.'));
  $form_state->setRedirect('entity.taxonomy_term.edit_form', ['taxonomy_term' => $term->id()]);
}

/**
 * Normalizes one geocoder-php Address result into this site's field shapes.
 *
 * @param \Geocoder\Model\Address $address
 *   One result from Geocoder::geocode() or ::reverse().
 * @param array{lat: float, lon: float}|null $pasted_coordinates
 *   When the admin pasted coordinates (a reverse-geocode lookup), the exact
 *   pasted pair -- written to the geofield in preference to whatever the
 *   geocoder echoes back, since a pin the admin visually confirmed is more
 *   accurate than anything re-derived from the address the reverse lookup
 *   resolved to.
 *
 * @return array{summary: string, address: array, geofield_value: string}
 */
function _apc_calendar_normalize_geocoder_address(\Geocoder\Model\Address $address, ?array $pasted_coordinates): array {
  $street_number = $address->getStreetNumber();
  $street_name = $address->getStreetName();
  $address_line1 = trim(($street_number ? $street_number . ' ' : '') . ($street_name ?? ''));

  // Nominatim's "locality" is not always populated for small venues -- a
  // town, village, or hamlet designation can arrive in its place. The
  // geocoder-php Nominatim provider maps the first of these it finds into
  // getLocality(), so this is not re-parsed here; if a venue's city still
  // comes back empty in practice, that gap lives in the provider, not here.
  $locality = $address->getLocality() ?? '';

  $administrative_area = '';
  foreach ($address->getAdminLevels() as $level) {
    $code = $level->getCode();
    if ($code && strlen($code) === 2) {
      $administrative_area = strtoupper($code);
      break;
    }
    $name = $level->getName();
    if ($name && isset(UsStates::NAME_TO_CODE[strtolower($name)])) {
      $administrative_area = UsStates::NAME_TO_CODE[strtolower($name)];
      break;
    }
  }

  $country_code = $address->getCountry()?->getCode() ?? 'US';
  $postal_code = $address->getPostalCode() ?? '';

  $coordinates = $address->getCoordinates();
  $lat = $pasted_coordinates['lat'] ?? $coordinates?->getLatitude();
  $lon = $pasted_coordinates['lon'] ?? $coordinates?->getLongitude();

  $summary_parts = array_filter([$address_line1, $locality, $administrative_area, $postal_code]);

  return [
    'summary' => $summary_parts ? implode(', ', $summary_parts) : t('(no address, coordinates only)')->render(),
    'address' => [
      'country_code' => $country_code,
      'address_line1' => $address_line1,
      'locality' => $locality,
      'administrative_area' => $administrative_area,
      'postal_code' => $postal_code,
    ],
    'geofield_value' => ($lat !== NULL && $lon !== NULL)
      ? Json::encode(['type' => 'Point', 'coordinates' => [$lon, $lat]])
      : '',
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for node_calendar_event_form (add).
 *
 * @see _apc_calendar_calendar_event_form_alter()
 */
function apc_calendar_form_node_calendar_event_form_alter(array &$form, FormStateInterface $form_state): void {
  _apc_calendar_calendar_event_form_alter($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for node_calendar_event_edit_form.
 *
 * ContentEntityForm::getFormId() appends the operation to the form ID unless
 * it is 'default', and Node's 'edit' form handler is registered under its
 * own 'edit' key (not reusing 'default') -- so the add form is
 * node_calendar_event_form but the edit form is
 * node_calendar_event_edit_form, a genuinely different hook_form_FORM_ID_alter()
 * target. Without this second implementation, everything in
 * _apc_calendar_calendar_event_form_alter() -- including the "Suggest tags"
 * button -- silently never ran on edit.
 *
 * @see _apc_calendar_calendar_event_form_alter()
 */
function apc_calendar_form_node_calendar_event_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  _apc_calendar_calendar_event_form_alter($form, $form_state);

  // Same convenience as community_photo's edit form (see
  // apc_calendar_form_node_community_photo_edit_form_alter()): link straight
  // to a selected image's own media edit form (crop, alt text, focal point)
  // instead of leaving the editor to hunt for it in the media library.
  // field_event_image allows up to 6 images (field_photo_image is just one),
  // so this adds one link per already-selected item -- into the Media
  // Library widget's own per-item row (selection.$delta), alongside its
  // existing remove_button/rendered_entity -- rather than a single
  // field-level link.
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->getEntity();
  if ($node->hasField('field_event_image') && isset($form['field_event_image']['widget']['selection'])) {
    foreach ($node->get('field_event_image')->referencedEntities() as $delta => $media) {
      if ($media->access('update') && isset($form['field_event_image']['widget']['selection'][$delta])) {
        $form['field_event_image']['widget']['selection'][$delta]['edit_media_link'] = [
          '#type' => 'link',
          '#title' => t('Edit this photo (crop, alt text, focal point)'),
          '#url' => $media->toUrl('edit-form', [
            'query' => ['destination' => Url::fromRoute('<current>')->toString()],
          ]),
          '#weight' => 100,
          '#attributes' => ['class' => ['button', 'button--small', 'apc-edit-media-link']],
        ];
      }
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for node_community_photo_form.
 *
 * @see _apc_calendar_community_photo_form_alter()
 */
function apc_calendar_form_node_community_photo_form_alter(array &$form, FormStateInterface $form_state): void {
  _apc_calendar_community_photo_form_alter($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for node_community_photo_edit_form.
 *
 * @see _apc_calendar_community_photo_form_alter()
 */
function apc_calendar_form_node_community_photo_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  _apc_calendar_community_photo_form_alter($form, $form_state);

  // Link straight to the referenced media item's own edit form (crop, alt
  // text, focal point) -- editing a community_photo node otherwise gives no
  // way to fix those without leaving the form and hunting for the media
  // item in the library. Only shown when a photo is already selected and the
  // current user can actually edit it (anonymous submitters never reach this
  // form -- see _apc_calendar_community_photo_form_alter() -- so this is
  // effectively editor/admin-only in practice).
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->getEntity();
  if ($node->hasField('field_photo_image') && !$node->get('field_photo_image')->isEmpty()) {
    $media = $node->get('field_photo_image')->entity;
    if ($media !== NULL && $media->access('update') && isset($form['field_photo_image'])) {
      $form['field_photo_image']['edit_media_link'] = [
        '#type' => 'link',
        '#title' => t('Edit this photo (crop, alt text, focal point)'),
        '#url' => $media->toUrl('edit-form', [
          'query' => ['destination' => Url::fromRoute('<current>')->toString()],
        ]),
        '#weight' => 100,
        '#attributes' => ['class' => ['button', 'button--small', 'apc-edit-media-link']],
      ];
    }
  }
}

/**
 * Implements hook_form_views_exposed_form_alter().
 *
 * Restricts the /calendar page's "Category" filter to tags that actually
 * have an event on the calendar right now, and appends a "(N)" count to
 * each. Out of ~120 tags on the site, only a dozen or so are ever attached
 * to a calendar_event -- the rest come from the much larger photo-tagging
 * vocabulary use -- so the unfiltered dropdown was mostly dead options a
 * visitor could pick and always get zero results from.
 *
 * Counts are computed against the same status/type/date-window filters as
 * views.view.calendar's own page_1 display (published, bundle
 * calendar_event, end date within the last month or later) so a number
 * shown here always matches what picking that option actually returns.
 * Deliberately a raw query rather than executing the view once per tag --
 * this runs on every page load and every AJAX filter change (see
 * calendar-filter.js), so it needs to stay a single query, not N.
 *
 * @see _apc_calendar_calendar_tag_event_counts()
 */
function apc_calendar_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'calendar' || $view->current_display !== 'page_1') {
    return;
  }
  if (!isset($form['field_tags_target_id']['#options'])) {
    return;
  }

  // "Category" is redundant next to the dropdown's own options ("- Any -",
  // tag names) and just adds a line of vertical space above an already
  // cramped calendar page; keep it as the select's accessible name instead
  // of a visible label.
  $form['field_tags_target_id']['#title_display'] = 'invisible';

  $counts = _apc_calendar_calendar_tag_event_counts();

  $options = $form['field_tags_target_id']['#options'];
  foreach ($options as $tid => $label) {
    // 'All' is the filter's own "- Any -" option, not a real term id.
    if ($tid === 'All') {
      continue;
    }
    if (empty($counts[$tid])) {
      unset($options[$tid]);
      continue;
    }
    $options[$tid] = $label . ' (' . $counts[$tid] . ')';
  }
  $form['field_tags_target_id']['#options'] = $options;
  $form['field_tags_target_id']['#cache']['tags'][] = 'node_list';
}

/**
 * Counts published calendar_event nodes per tag.
 *
 * Mirrors views.view.calendar page_1's own status/type/date-window filters
 * (see that config's `filters` section) so a tag only shows up here if
 * selecting it on the calendar would actually return something. Does not
 * replicate node grants/access-control query rewriting the way the real
 * view does -- fine on this site (no private calendar_event content), but
 * worth knowing if that ever changes.
 *
 * @return int[]
 *   Term ID => count of distinct published calendar_event nodes carrying
 *   that tag. A recurring event's multiple date deltas count once, not
 *   once per occurrence.
 */
function _apc_calendar_calendar_tag_event_counts(): array {
  $cutoff = strtotime('-1 month', \Drupal::time()->getRequestTime());

  $query = \Drupal::database()->select('node__field_tags', 'ft');
  $query->innerJoin('node_field_data', 'n', 'n.nid = ft.entity_id');
  $query->innerJoin('node__field_event_date', 'fed', 'fed.entity_id = ft.entity_id AND fed.deleted = 0');
  $query->condition('n.type', 'calendar_event');
  $query->condition('n.status', 1);
  $query->condition('ft.deleted', 0);
  $query->condition('fed.field_event_date_end_value', $cutoff, '>=');
  $query->addField('ft', 'field_tags_target_id', 'tid');
  $query->addExpression('COUNT(DISTINCT n.nid)', 'cnt');
  $query->groupBy('ft.field_tags_target_id');

  $counts = [];
  foreach ($query->execute() as $row) {
    $counts[(int) $row->tid] = (int) $row->cnt;
  }
  return $counts;
}

/**
 * Forces the anonymous visitor's PHP session to actually start and persist.
 *
 * Both the calendar_event and community_photo forms have a Media Library
 * image field, and dropzonejs (enabled for its drag-and-drop uploader)
 * unconditionally takes over that field's "Add media" upload for every user,
 * anonymous included. Its upload endpoint (dropzonejs.upload) is protected by
 * a route-level `_csrf_token: 'TRUE'` requirement, and that CSRF token is
 * bound to the PHP session -- so for a visitor with no pre-existing session,
 * something has to make that session real before the token is generated.
 *
 * `\Drupal::service('session_manager')->start()` on its own does NOT do
 * that, confirmed by instrumenting SessionManager directly: it only performs
 * a *lazy* start (session_id() stays empty, isStarted() stays FALSE) unless a
 * session cookie already exists. A real session only gets persisted later, in
 * SessionManager::save(), and only if the session contains data that counts
 * -- and per SessionManager::getSessionDataMask(), the CSRF token seed
 * (stored in the *metadata* bag) is explicitly excluded from that count. This
 * is deliberate: Drupal doesn't want merely generating a CSRF token on a page
 * (a routine, incidental thing) to force a session and break anonymous
 * page-cache hit rates. The practical effect is that dropzonejs's element
 * generates a token against a seed that's created but never survives to the
 * next request -- every anonymous upload 403's, without exception. Not a
 * caching or environment quirk; the module just never writes anything that
 * Drupal considers "real" session data.
 *
 * The fix is to write something that *does* count -- any ordinary session
 * attribute, not the metadata bag -- which is what actually flips
 * getSessionDataMask() and makes SessionManager::save() persist a real
 * session and issue a cookie. Doing this on the initial form render (before
 * "Add media" is ever clicked) means the browser already carries that cookie
 * into the later "Add media" AJAX request (where the token is generated) and
 * the upload POST (where it's validated), so the seed survives the round
 * trip the same way it would for an authenticated user, whose session
 * already exists by definition.
 *
 * @see _apc_calendar_community_photo_form_alter()
 * @see _apc_calendar_calendar_event_form_alter()
 */
function _apc_calendar_ensure_anonymous_session(): void {
  \Drupal::request()->getSession()->set('apc_calendar_anonymous_submission', TRUE);
}

/**
 * Shared implementation for the community_photo add and edit forms.
 *
 * The anonymous-submitter handling is the same problem, and the same fix, as
 * the calendar_event form: an anonymous visitor cannot view their own
 * unpublished node, so core's NodeForm::save() would bounce them to the front
 * page with a "has been created" message reading as if the photo is already
 * live. Redirect them to an accurate thank-you page and hide the
 * revision-authoring controls that mean nothing to a public submitter.
 * community_photo has no body/summary field, so that piece of the event
 * handling has no analogue here.
 *
 * @see _apc_calendar_calendar_event_form_alter()
 * @see \Drupal\apc_calendar\Controller\PhotoSubmittedController
 */
function _apc_calendar_community_photo_form_alter(array &$form, FormStateInterface $form_state): void {
  // Media Library dialog scroll fix applies to every submitter, not just
  // anonymous ones -- keep this above the early return below.
  $form['#attached']['library'][] = 'apc_calendar/media_dialog_scroll_top';

  if (!\Drupal::currentUser()->isAnonymous()) {
    return;
  }

  _apc_calendar_ensure_anonymous_session();

  // Append after ::save so this redirect wins over the one NodeForm sets.
  $form['actions']['submit']['#submit'][] = 'apc_calendar_photo_submit_confirmation';

  foreach (['revision', 'revision_log', 'revision_information'] as $element) {
    if (isset($form[$element])) {
      $form[$element]['#access'] = FALSE;
    }
  }
}

/**
 * Shared implementation for the calendar_event add and edit forms.
 *
 * Anonymous submitters cannot view their own unpublished node (core blocks
 * "view own unpublished content" for anonymous — every anonymous node is owned
 * by uid 0, so the permission would expose the entire moderation queue). Core's
 * NodeForm::save() therefore falls back to redirecting them to the front page
 * with a "has been created" message that reads as though the event is live.
 *
 * Send them to a dedicated thank-you page with an accurate message instead.
 *
 * @see apc_calendar_form_node_calendar_event_form_alter()
 * @see apc_calendar_form_node_calendar_event_edit_form_alter()
 */
function _apc_calendar_calendar_event_form_alter(array &$form, FormStateInterface $form_state): void {
  $account = \Drupal::currentUser();

  // Media Library dialog scroll fix -- affects anonymous and authenticated
  // submitters alike, so it's attached unconditionally here.
  $form['#attached']['library'][] = 'apc_calendar/media_dialog_scroll_top';

  // Whether this node was created by the Feeds importer (event-import-task.md)
  // rather than typed in through this form. feeds_item is the authoritative
  // signal -- it's the same check apc_calendar_node_presave() uses to skip its
  // auto-publish branch during an import -- unlike field_import_state, which
  // defaults to "pending" on every node regardless of origin and so can't be
  // used to tell the two apart. A brand-new node (the add form) is never
  // imported: Feeds always creates its own nodes directly, it never posts
  // through this form.
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->getEntity();
  $is_imported = $node->hasField('feeds_item') && !$node->get('feeds_item')->isEmpty();

  // The Feeds-import bookkeeping fields (event-import-task.md) --
  // field_event_source, field_import_location_raw, field_import_state and
  // field_import_recurrence_raw -- are meaningful only for nodes Feeds
  // actually created; on every other event they're just confusing clutter.
  // Gated on $is_imported rather than role/anonymity, so even an
  // event_manager editing a human-submitted event doesn't see them, while a
  // curator editing an actual imported event still can. Curators change
  // field_import_state itself through the imported_events view's bulk
  // actions, not this form -- but field_import_location_raw and
  // field_import_recurrence_raw are read directly off this form while
  // curating, so those two still need to show for imported events.
  if (!$is_imported) {
    foreach ([
      'field_event_source',
      'field_import_location_raw',
      'field_import_state',
      'field_import_recurrence_raw',
    ] as $element) {
      if (isset($form[$element])) {
        $form[$element]['#access'] = FALSE;
      }
    }
  }

  // Hide the body summary for everyone. The "Edit summary" toggle and its
  // textarea are a teaser-preview authoring affordance nothing on this site
  // ever uses. #access rather than turning off display_summary in the field
  // config, which would remove the underlying value (and any admin's ability
  // to turn this back on for a single node) rather than just hiding the
  // control.
  if (isset($form['body']['widget'][0]['summary'])) {
    $form['body']['widget'][0]['summary']['#access'] = FALSE;
  }

  // The confirmation redirect is anonymous-only — authenticated submitters can
  // view their own unpublished node, so core's default behaviour is correct
  // for them.
  if ($account->isAnonymous()) {
    _apc_calendar_ensure_anonymous_session();

    // Append after ::save so this redirect wins over the one NodeForm sets.
    $form['actions']['submit']['#submit'][] = 'apc_calendar_event_submit_confirmation';

    // Hide the revision controls. ContentEntityForm::addRevisionableFormFields()
    // adds these programmatically rather than through the form display, which is
    // why they cannot simply be dragged to Disabled in Manage Form Display —
    // and why they show to a visitor who has no idea what a revision is.
    foreach (['revision', 'revision_log', 'revision_information'] as $element) {
      if (isset($form[$element])) {
        $form[$element]['#access'] = FALSE;
      }
    }
  }

  // The add-location affordance is for everyone who may create a location,
  // gated on the same permission the route requires so the link can never lead
  // to a 403. Keeping this outside the anonymous branch matters: it carries the
  // library attachment for the autocomplete enhancement as well as the link.
  if ($account->hasPermission('create terms in locations')) {
    apc_calendar_attach_add_location_link($form);
  }

  // Move the source calendar's raw LOCATION string (field_import_location_raw)
  // to render directly under the Location field -- right where a curator is
  // about to decide whether to match it to an existing term or create a new
  // one, instead of its default form-display position far down the form,
  // disconnected from the decision it's meant to inform. Moved, not copied,
  // out of its default slot so nothing renders twice; #weight => 100 sorts it
  // after whatever else field_location already carries (the widget itself,
  // and the "Add a new location" link when the permission check above added
  // it). Non-imported nodes never reach here with the field intact -- the
  // #access => FALSE set on it earlier travels with the array when it moves.
  if (isset($form['field_location']) && isset($form['field_import_location_raw'])) {
    $form['field_location']['field_import_location_raw'] = $form['field_import_location_raw'];
    $form['field_location']['field_import_location_raw']['#weight'] = 100;
    unset($form['field_import_location_raw']);
  }

  // "Suggest tags" — everyone gets it, anonymous included, same as the
  // add-location affordance above. #limit_validation_errors => [] is what
  // keeps a half-filled form (e.g. no location yet) from raising every other
  // field's validation errors just because this button was clicked; this is
  // not a real submission.
  if (isset($form['field_tags'])) {
    $form['field_tags']['apc_tag_suggestions'] = [
      '#type' => 'container',
      '#attributes' => ['id' => 'apc-tag-suggestions'],
      '#weight' => 10,
    ];

    // Stashed in $form_state by apc_calendar_tag_suggest_submit() and
    // survives the rebuild; rebuilt fresh here (not in the submit handler)
    // because $form itself does not persist across a rebuild, only
    // $form_state does. All checked by default -- unchecking is the
    // deliberate act, per the design. NULL (button never clicked this
    // request) is distinct from an empty array (clicked, nothing matched) --
    // only the latter gets a "nothing found" message, so the container stays
    // silent until the submitter has actually asked.
    //
    // $suggestions is [tid => label] (see TagSuggester::suggest()) --
    // #options already wants that shape directly, and #default_value wants
    // just the keys (the tids) to check.
    $suggestions = $form_state->get('apc_tag_suggestions');
    if ($suggestions) {
      $form['field_tags']['apc_tag_suggestions']['tags'] = [
        '#type' => 'checkboxes',
        '#title' => t('Suggested tags'),
        '#options' => $suggestions,
        '#default_value' => array_keys($suggestions),
        // Explicit rather than left to default computation: $form['field_tags']
        // (the field widget's own outer wrapper) is not #tree, so an element
        // nested under it with no #parents of its own does not land where its
        // render-array position suggests -- it flattens to a bare top-level
        // 'tags' key in $form_state->getValues(), same depth as 'title' or
        // 'body'. Fixing the read site to match that incidental flattening
        // would work today but silently break the moment this element's
        // position in the render array changes; naming the parents directly
        // removes the dependency on that behaviour entirely.
        '#parents' => ['apc_tag_suggestions_checked'],
      ];
    }
    elseif ($suggestions !== NULL) {
      $form['field_tags']['apc_tag_suggestions']['empty'] = [
        '#markup' => t('No tag suggestions found for the current title and body.'),
      ];
    }

    $form['field_tags']['apc_tag_suggest'] = [
      '#type' => 'submit',
      '#value' => t('Suggest tags'),
      '#limit_validation_errors' => [],
      '#submit' => ['apc_calendar_tag_suggest_submit'],
      '#ajax' => [
        'callback' => 'apc_calendar_tag_suggest_ajax',
        'wrapper' => 'apc-tag-suggestions',
      ],
      '#weight' => 9,
    ];

    // Insert before whichever handler currently saves the entity, rather
    // than assuming the array's exact contents -- the anonymous branch above
    // may or may not have already appended
    // apc_calendar_event_submit_confirmation, and this must not clobber it
    // either way. By the time apc_calendar_apply_suggested_tags() runs,
    // ::submitForm has already built the entity from the widget values, so
    // it acts on the built node directly rather than the tags widget's own
    // text string.
    $submit_handlers = $form['actions']['submit']['#submit'];
    $save_index = array_search('::save', $submit_handlers, TRUE);
    if ($save_index !== FALSE) {
      array_splice($submit_handlers, $save_index, 0, ['apc_calendar_apply_suggested_tags']);
      $form['actions']['submit']['#submit'] = $submit_handlers;
    }
  }

  // The online-only checkbox is available to everyone, anonymous included —
  // no #access gating. #states below only ever hides these elements in the
  // browser; it does not stop a POST that includes both a checked box and a
  // location value. Location itself is optional either way (not just for
  // virtual events) — apc_calendar_node_presave() still clears it whenever
  // field_virtual is checked, so a virtual event never carries a stray
  // location, but a non-virtual event with no location is a valid,
  // supported state (e.g. a location still being worked out) rather than a
  // validation error.
  if (isset($form['field_location']) && isset($form['field_event_url'])) {
    $form['field_location']['#states'] = [
      'invisible' => [
        ':input[name="field_virtual[value]"]' => ['checked' => TRUE],
      ],
    ];
    $form['field_event_url']['#states'] = [
      'invisible' => [
        ':input[name="field_virtual[value]"]' => ['checked' => FALSE],
      ],
    ];
  }

  // Show the curator a ready-to-enter local end date for the source
  // calendar's raw RRULE, when this field is present on the form display
  // and the node actually has one. field_import_recurrence_raw only ever
  // holds the untouched source string (feeds_ical never expands RRULE --
  // see event-import-task.md), and its UNTIL value is always UTC per
  // RFC5545 -- hand-converting that to the site's local timezone is
  // exactly the kind of date arithmetic a curator gets wrong (see the
  // README's "UNTIL is UTC and will trick you" note). Doing it here means
  // nobody has to.
  if ($is_imported && isset($form['field_import_recurrence_raw'])) {
    $raw = $node->hasField('field_import_recurrence_raw') ? (string) $node->get('field_import_recurrence_raw')->value : '';
    if ($raw !== '') {
      $parsed = _apc_calendar_parse_recurrence_end($raw);
      if ($parsed === NULL) {
        $hint = t('No explicit end date or count found in the source recurrence rule above -- pick a reasonable end yourself under Event Date → Ends.');
      }
      elseif ($parsed['type'] === 'UNTIL') {
        $hint = t('Computed from the RRULE above: this series ends @date, local time -- enter that date under Event Date → Ends → On Date.', ['@date' => $parsed['display']]);
      }
      else {
        $hint = t('Computed from the RRULE above: this series ends after @count occurrences -- enter @count under Event Date → Ends → After.', ['@count' => $parsed['value']]);
      }
      $form['field_import_recurrence_raw']['#suffix'] = '<div class="apc-recurrence-end-hint messages messages--status">' . $hint . '</div>';
    }
  }

  if (isset($form['field_event_date'])) {
    $form['#validate'][] = 'apc_calendar_form_node_calendar_event_form_validate_recurrence';
  }
}

/**
 * Parses UNTIL/COUNT out of a raw RRULE string, converting UNTIL to local time.
 *
 * UNTIL is always UTC per RFC5545 (RFC5545 §3.3.10); Smart Date's own "Ends
 * on date" widget wants a plain local calendar date. Converting it here,
 * once, correctly, removes the exact hand-conversion mistake documented in
 * the README ("UNTIL is UTC and will trick you").
 *
 * @return array{type: string, value: string, display?: string}|null
 *   ['type' => 'UNTIL', 'value' => <Y-m-d, local>, 'display' => <human
 *   string>], or ['type' => 'COUNT', 'value' => <raw count>], or NULL when
 *   the raw string has neither (e.g. Forward TX's own no-UNTIL series --
 *   see event-import-task.md's "Two series have no UNTIL").
 */
function _apc_calendar_parse_recurrence_end(string $raw): ?array {
  if (preg_match('/\bUNTIL=([0-9]{8}T[0-9]{6}Z?)/', $raw, $matches)) {
    $utc_string = rtrim($matches[1], 'Z');
    $date = \DateTime::createFromFormat('Ymd\THis', $utc_string, new \DateTimeZone('UTC'));
    if (!$date) {
      return NULL;
    }
    $site_timezone = \Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get();
    $date->setTimezone(new \DateTimeZone($site_timezone));
    return [
      'type' => 'UNTIL',
      'value' => $date->format('Y-m-d'),
      'display' => $date->format('l, F j, Y \a\t g:ia T'),
    ];
  }

  if (preg_match('/\bCOUNT=(\d+)/', $raw, $matches)) {
    return ['type' => 'COUNT', 'value' => $matches[1]];
  }

  return NULL;
}

/**
 * Form validation handler: bound how many instances a recurring event can generate.
 *
 * Smart Date Recur has no built-in ceiling on the past side of a recurring
 * rule: given no explicit "Ends" value, it treats the rule as unlimited and
 * generates every instance from the field's actual start date through 12
 * months past *today* -- see smart_date_recur_generate_rows() in
 * smart_date_recur.module ($before = +month_limit from now, no $after
 * bound at all). A standing weekly meeting imported with a start date over a
 * year in the past therefore keeps generating more instances every week it
 * remains unaddressed, with nothing surfacing that growth anywhere in the
 * curation UI.
 *
 * This is not a theoretical concern -- it took down /calendar in production
 * on 2026-09-11 (node 277, "What's The Plan: Weekly Call with Indivisible"):
 * a July 2025 start date with weekly recurrence and "Ends: Never" had grown
 * to 113 instances, and fullcalendar_view's rendering of that many deltas
 * through Drupal\views\Plugin\views\field\EntityField::prepareItemsByDelta()
 * throws "Undefined array key" and 500s the whole page. Confirmed as a
 * known, still-unresolved upstream limitation, not something patchable on
 * our side: https://www.drupal.org/project/fullcalendar_view/issues/3272681
 * reports the same warning at as few as 10-20 instances on other sites. The
 * cap chosen below (60) is a deliberately conservative guess with that in
 * mind, not a value confirmed safe on this codebase's exact module
 * versions -- reduce it if /calendar ever reproduces this again under it.
 *
 * Two things this checks, per date delta (the field allows multiple):
 * - A chosen repeat frequency always requires an explicit "Ends" (COUNT or
 *   UNTIL) -- "Never" is refused outright, regardless of instance count.
 * - Even with an explicit "Ends", the resulting instance count is estimated
 *   and refused if it would exceed the cap.
 *
 * The COUNT case is exact (Smart Date's own "Ends after" value already *is*
 * the total instance count). The UNTIL case is only an estimate -- it
 * divides the start-to-until span by frequency * interval and does not
 * account for "Advanced" multi-weekday selections, which would multiply a
 * WEEKLY estimate further. Every recurring event on this site so far is a
 * plain single-weekday rule (see event-import-task.md), so this
 * under-counting risk is accepted rather than built around.
 *
 * Deliberately reads raw submitted values for repeat/repeat-end/interval
 * (simple select/number/date elements, safe to read directly) but the
 * start date from the *currently saved* entity rather than the submitted
 * date sub-widget -- calling $form_state->getFormObject()->buildEntity()
 * here to get Smart Date's own massaged value would trigger
 * smart_date_recur_generate_rows()'s immediate $rrule->save(), creating a
 * real SmartDateRule entity as a side effect of mere validation. Known
 * consequence: a delta whose start date is being changed in the very same
 * edit that adds recurrence is checked against its *old* start date, not
 * the new one. A brand-new date item (no saved entity value yet, i.e. a
 * genuinely new event/date being added today) has no history to estimate,
 * so it is skipped -- nothing dates back before today for it.
 *
 * @see apc_calendar_form_node_calendar_event_form_alter()
 * @see apc_calendar_form_node_calendar_event_edit_form_alter()
 */
function apc_calendar_form_node_calendar_event_form_validate_recurrence(array &$form, FormStateInterface $form_state): void {
  $max_instances = 60;

  $deltas = $form_state->getValue('field_event_date');
  if (!is_array($deltas)) {
    return;
  }

  /** @var \Drupal\node\NodeInterface $entity */
  $entity = $form_state->getFormObject()->getEntity();
  $seconds_per_unit = [
    'DAILY' => 86400,
    'WEEKLY' => 604800,
    'MONTHLY' => 2629800,
    'YEARLY' => 31557600,
  ];

  foreach ($deltas as $delta => $item) {
    if (!is_array($item) || empty($item['repeat'])) {
      continue;
    }

    $element = $form['field_event_date']['widget'][$delta] ?? $form['field_event_date']['widget'];

    if (empty($item['repeat-end'])) {
      $form_state->setError($element, t('Recurring events need a defined end -- choose "After" or "On Date" under Ends. Left on "Never," a recurring event can quietly grow to hundreds of individual dates and has broken the public calendar page before.'));
      continue;
    }

    if ($item['repeat-end'] === 'COUNT') {
      $count = (int) ($item['repeat-end-count'] ?? 0);
      if ($count > $max_instances) {
        $form_state->setError($element, t('Repeating "after @count times" creates that many individual dates, which is more than this calendar page can reliably display (max @max). Reduce the count, or extend the interval between repeats instead.', [
          '@count' => $count,
          '@max' => $max_instances,
        ]));
      }
      continue;
    }

    if ($item['repeat-end'] === 'UNTIL' && !empty($item['repeat-end-date'])) {
      $until = strtotime($item['repeat-end-date']);
      $start = NULL;
      if ($entity->hasField('field_event_date') && !$entity->get('field_event_date')->isEmpty()) {
        $current = $entity->get('field_event_date')->get($delta) ?? NULL;
        $start = $current ? (int) $current->value : NULL;
      }
      if ($until && $start) {
        $unit_seconds = $seconds_per_unit[$item['repeat']] ?? 604800;
        $interval = max(1, (int) ($item['interval'] ?? 1));
        $estimate = (int) ceil(max(0, $until - $start) / ($unit_seconds * $interval));
        if ($estimate > $max_instances) {
          $form_state->setError($element, t('This end date would create roughly @estimate individual dates for this event (max @max) -- mostly because the start date is far in the past. Either pick a nearer end date, or update the start date to the next upcoming occurrence before adding recurrence.', [
            '@estimate' => $estimate,
            '@max' => $max_instances,
          ]));
        }
      }
    }
  }
}

/**
 * Adds the "add a new location" modal trigger beneath the Location field.
 *
 * The autocomplete does the searching; this only covers the case where nothing
 * matches. Rendered as a plain link with core's dialog attributes rather than a
 * button, so it stays quiet next to the field it supplements.
 *
 * @see \Drupal\apc_calendar\Form\AddLocationForm
 */
function apc_calendar_attach_add_location_link(array &$form): void {
  if (!isset($form['field_location']['widget'][0]['target_id'])) {
    return;
  }

  // The modal's AJAX response writes the new location back into this element,
  // so give it a stable hook that does not depend on Drupal's generated IDs.
  $form['field_location']['widget'][0]['target_id']['#attributes']['data-apc-location-autocomplete'] = TRUE;

  // Prepended (not appended) so it runs before EntityAutocomplete's own
  // #element_validate callback. FormState::setErrorByName() only ever keeps
  // the *first* error set for a given element (see FormState::setErrorByName()),
  // so claiming that slot first is what replaces core's generic "There are
  // no Taxonomy terms matching ..." message with one that actually tells the
  // submitter what to do about it.
  //
  // #element_validate is not yet populated with EntityAutocomplete's own
  // default callback at this point in the form-alter lifecycle (it is merged
  // in later, from the element's #type defaults) -- '??' supplies it
  // explicitly rather than assuming it is already present.
  $form['field_location']['widget'][0]['target_id']['#element_validate'] = array_merge(
    ['apc_calendar_validate_location_not_found'],
    $form['field_location']['widget'][0]['target_id']['#element_validate'] ?? [[EntityAutocomplete::class, 'validateEntityAutocomplete']],
  );

  $form['field_location']['apc_add_location'] = [
    '#type' => 'link',
    '#title' => t('Can’t find it? Add a new location'),
    '#url' => Url::fromRoute('apc_calendar.add_location'),
    '#attributes' => [
      'class' => ['use-ajax', 'apc-add-location-link'],
      'data-dialog-type' => 'modal',
      'data-dialog-options' => Json::encode([
        'width' => 520,
        'title' => t('Add a new location')->render(),
      ]),
    ],
    '#attached' => [
      'library' => [
        'core/drupal.dialog.ajax',
        // Adds "＋ Add a new venue…" to the autocomplete results, which is the
        // only affordance visible in the zero-results case. The link above is
        // the no-JavaScript fallback and stays regardless.
        'apc_calendar/add_location_autocomplete',
      ],
    ],
    '#weight' => 10,
  ];
}

/**
 * Element validate callback: clear "location not found" feedback.
 *
 * Runs before EntityAutocomplete::validateEntityAutocomplete() (prepended
 * onto the same element in apc_calendar_attach_add_location_link()) so that
 * when the submitter's typed text doesn't resolve to an existing location,
 * this message wins instead of core's generic "There are no Taxonomy terms
 * matching ..." -- which never mentioned "location" and gave no hint that
 * the "Add a new location" link right below the field is how to fix it.
 *
 * Does nothing (lets core's own validator run as normal) for an empty value
 * or one that already carries a valid "(tid)" suffix -- i.e. something
 * actually selected from the autocomplete dropdown, or handed back by
 * AddLocationForm after adding a new location.
 *
 * @see apc_calendar_attach_add_location_link()
 * @see \Drupal\apc_calendar\Form\AddLocationForm
 */
function apc_calendar_validate_location_not_found(array &$element, FormStateInterface $form_state, array &$complete_form): void {
  $input = trim((string) ($element['#value'] ?? ''));
  if ($input === '' || EntityAutocomplete::extractEntityIdFromAutocompleteInput($input) !== NULL) {
    return;
  }

  $options = ($element['#selection_settings'] ?? []) + [
    'target_type' => $element['#target_type'],
    'handler' => $element['#selection_handler'],
  ];
  $handler = \Drupal::service('plugin.manager.entity_reference_selection')->getInstance($options);
  $matches = $handler->getReferenceableEntities($input, '=', 1);

  if (empty(reset($matches))) {
    $form_state->setError($element, t('We couldn’t find a location called "%value". Use "Can’t find it? Add a new location" below to add it.', [
      '%value' => $input,
    ]));
  }
}

/**
 * Submit handler for the "Suggest tags" button.
 *
 * Reads title and body from $form_state (not from the entity -- the node
 * behind this form is not saved yet), calls TagSuggester, and stashes the
 * result in $form_state so apc_calendar_form_node_calendar_event_form_alter()
 * can rebuild the checkbox list on the next pass. Runs before core's own
 * ::save handler ever fires; nothing here touches the entity.
 *
 * @see apc_calendar_form_node_calendar_event_form_alter()
 * @see apc_calendar_tag_suggest_ajax()
 */
function apc_calendar_tag_suggest_submit(array $form, FormStateInterface $form_state): void {
  // Read from raw user input, not $form_state->getValues() -- with
  // #limit_validation_errors => [] (an empty array, not FALSE),
  // FormValidator::handleErrorsWithLimitedValidation() rebuilds the values
  // array to contain *only* the listed sections, which is none of them
  // here. title and body would silently come back empty from getValue() even
  // though the submitter typed them. getUserInput() is the raw POST data and
  // is not filtered by #limit_validation_errors at all.
  $input = $form_state->getUserInput();
  $title = (string) ($input['title'][0]['value'] ?? '');
  $body = (string) ($input['body'][0]['value'] ?? '');

  $suggestions = \Drupal::service('apc_calendar.tag_suggester')->suggest($title, $body);
  $form_state->set('apc_tag_suggestions', $suggestions);
  $form_state->setRebuild(TRUE);
}

/**
 * AJAX callback for the "Suggest tags" button.
 *
 * Returns only the suggestions container -- the rest of the rebuilt $form is
 * discarded, never sent to the browser. See the "one real risk" note in
 * auto-tag-task.md: the server-side rebuild that produces this container is
 * a full form rebuild (Smart Date, Media Library, focal point and all), even
 * though only this one piece of it is returned.
 *
 * @see apc_calendar_form_node_calendar_event_form_alter()
 * @see apc_calendar_tag_suggest_submit()
 */
function apc_calendar_tag_suggest_ajax(array $form, FormStateInterface $form_state): array {
  return $form['field_tags']['apc_tag_suggestions'];
}

/**
 * Submit handler: applies checked tag suggestions to the entity.
 *
 * Spliced in immediately before ::save (see
 * apc_calendar_form_node_calendar_event_form_alter()), so ::submitForm has
 * already built the entity from the widget's own values by the time this
 * runs. Acts on the built node directly -- never touches the tags widget's
 * text string or its comma-quoting format.
 *
 * Unlike the old config-backed map, a suggestion can only ever exist for a
 * term that already exists -- TagSuggester only matches terms that already
 * have field_tag_keywords populated (see TagSuggester::suggest()) -- so
 * there is no "find or create by name" step here any more, just a load by
 * the tid the checkbox already carries.
 *
 * @see apc_calendar_form_node_calendar_event_form_alter()
 * @see \Drupal\apc_calendar\TagSuggester
 */
function apc_calendar_apply_suggested_tags(array $form, FormStateInterface $form_state): void {
  $checked = array_filter($form_state->getValue('apc_tag_suggestions_checked') ?? []);
  if (!$checked) {
    return;
  }

  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface || !$node->hasField('field_tags')) {
    return;
  }

  // Tracked so a suggestion the submitter also typed by hand gets one
  // reference, not two.
  $existing_tids = [];
  foreach ($node->get('field_tags') as $item) {
    if ($item->target_id) {
      $existing_tids[(int) $item->target_id] = TRUE;
    }
  }

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach (array_keys($checked) as $tid) {
    $tid = (int) $tid;
    // The term could in principle have been deleted between the AJAX
    // suggestion and this submission; skip rather than create a bare
    // replacement -- that would silently reintroduce the "find or create"
    // problem this design specifically avoids.
    if (isset($existing_tids[$tid]) || !$storage->load($tid)) {
      continue;
    }
    $node->get('field_tags')->appendItem($tid);
    $existing_tids[$tid] = TRUE;
  }
}

/**
 * Submit handler: redirect anonymous submitters to the thank-you page.
 *
 * @see apc_calendar_form_node_calendar_event_form_alter()
 */
function apc_calendar_event_submit_confirmation(array $form, FormStateInterface $form_state): void {
  // Drop NodeForm::save()'s "Calendar Event X has been created." status
  // message, which implies the event is already live. The confirmation page
  // renders its own, accurate message.
  \Drupal::messenger()->deleteByType(MessengerInterface::TYPE_STATUS);

  // Hand the new node's ID to the confirmation controller through the
  // per-session private tempstore — never through a query parameter, since an
  // enumerable ?nid= on an unpublished node would expose the pending queue.
  //
  // The timestamp travels with it so the controller can enforce its own short
  // freshness window: tempstore.expire defaults to a week, which would leave a
  // submission readable to whoever uses the same browser next. That parameter
  // is shared with Views UI and every other private tempstore consumer, so it
  // must not be lowered globally to solve a problem local to this page.
  $node = $form_state->getFormObject()->getEntity();
  \Drupal::service('tempstore.private')
    ->get(EventSubmittedController::COLLECTION)
    ->set(EventSubmittedController::KEY, [
      'nid' => (int) $node->id(),
      'time' => \Drupal::time()->getRequestTime(),
    ]);

  $form_state->setRedirect('apc_calendar.event_submitted');
}

/**
 * Submit handler: redirect anonymous photo submitters to the thank-you page.
 *
 * Same tempstore-handoff / status-message-suppression pattern as
 * apc_calendar_event_submit_confirmation(); see its comments for the why of
 * each step (no enumerable ?nid=, per-session freshness, dropping the
 * misleading "has been created" message).
 *
 * @see _apc_calendar_community_photo_form_alter()
 */
function apc_calendar_photo_submit_confirmation(array $form, FormStateInterface $form_state): void {
  \Drupal::messenger()->deleteByType(MessengerInterface::TYPE_STATUS);

  $node = $form_state->getFormObject()->getEntity();
  \Drupal::service('tempstore.private')
    ->get(PhotoSubmittedController::COLLECTION)
    ->set(PhotoSubmittedController::KEY, [
      'nid' => (int) $node->id(),
      'time' => \Drupal::time()->getRequestTime(),
    ]);

  $form_state->setRedirect('apc_calendar.photo_submitted');
}

/**
 * Implements hook_node_access().
 *
 * event_manager has 'edit any calendar_event content' but not 'bypass node
 * access' or 'view own unpublished content', so without this an event_manager
 * gets a 403 visiting a pending event's own canonical page and can only act on
 * it from the /admin/content/pending-events bulk-operations list. Grants view
 * access to unpublished calendar_event nodes specifically -- not a general
 * bypass -- to whoever already holds edit access to any calendar_event, so a
 * reviewer can see the full rendered page (photos, body, location) before
 * publishing it. Neutral (never forbidden) for every other case, so this
 * never overrides core's own access decisions.
 *
 * @see \Drupal\apc_calendar\Controller\PublishEventAndLocationController
 */
function apc_calendar_node_access(NodeInterface $node, string $op, AccountInterface $account): AccessResultInterface {
  if ($op === 'view' && $node->bundle() === 'calendar_event' && !$node->isPublished()
    && $account->hasPermission('edit any calendar_event content')) {
    return AccessResult::allowed()->cachePerPermissions()->addCacheableDependency($node);
  }
  // Same reviewer-view grant for pending community_photo submissions, so a
  // manager can open a pending photo's own page (and the /photos "View node"
  // link) before publishing it. Gated on edit access to this bundle, not a
  // general bypass.
  if ($op === 'view' && $node->bundle() === 'community_photo' && !$node->isPublished()
    && $account->hasPermission('edit any community_photo content')) {
    return AccessResult::allowed()->cachePerPermissions()->addCacheableDependency($node);
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_entity_operation().
 *
 * Adds a one-click "Publish" operation to each unpublished community_photo,
 * shown wherever node operations render -- notably the moderation queue at
 * /admin/content/photos. It links to apc_calendar.publish_photo, which flips
 * the node published and returns to the list, versus the select-then-apply of
 * the bulk publish action. Weighted first so it is the dropbutton's primary
 * (single-click) action. Gated on the same node.update access the route
 * enforces, so it never appears where following it would 403.
 */
function apc_calendar_entity_operation(EntityInterface $entity): array {
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'community_photo') {
    return [];
  }
  if ($entity->isPublished() || !$entity->access('update')) {
    return [];
  }
  return [
    'publish_photo' => [
      'title' => t('Publish'),
      'weight' => -10,
      'url' => Url::fromRoute('apc_calendar.publish_photo', ['node' => $entity->id()]),
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for node entities.
 *
 * Two unrelated concerns live here because both are calendar_event-only
 * presave rules and Drupal only calls one hook_ENTITY_TYPE_presave() per
 * module per entity type:
 *
 * - #states hides field_location client-side when field_virtual is checked,
 *   but that is cosmetic only — it does not stop a POST carrying a location
 *   value (devtools, a stale cached form, a bot). Clearing it here is what
 *   actually makes a virtual event location-less, and it is also why the
 *   display side needs no conditional logic anywhere: an empty field renders
 *   nothing in any view mode, template, or view.
 * - calendar_event defaults to unpublished (core.base_field_override.node.
 *   calendar_event.status.yml), which is the entire moderation mechanic for
 *   anonymous and ordinary authenticated submitters. A submitter with the
 *   'publish calendar_event content immediately' permission is trusted to
 *   skip that queue, so their new nodes are published here instead of
 *   waiting for review. Presave rather than granting 'administer nodes' (the
 *   permission that would otherwise be needed to expose the Published
 *   checkbox on the form) — that permission is much broader than "publish my
 *   own submissions" and would also let the role edit other administrative
 *   fields (authoring info, sticky, promote) on *any* content type.
 *
 *   This check is gated out entirely for Feeds-imported nodes (a non-empty
 *   feeds_item). Feeds saves programmatically under whichever admin account
 *   triggered the import (manually or via cron), so \Drupal::currentUser()
 *   here is that admin's session, not the actual submitter -- without this
 *   guard, every imported event publishes immediately because the person
 *   running the import always holds this permission, silently defeating the
 *   whole curation queue described in event-import-task.md.
 *
 * @see apc_calendar_form_node_calendar_event_form_alter()
 */
function apc_calendar_node_presave(NodeInterface $node): void {
  if ($node->bundle() === 'calendar_event') {
    if ($node->hasField('field_virtual') && $node->hasField('field_location') && (bool) $node->get('field_virtual')->value) {
      $node->set('field_location', []);
    }

    $is_feeds_import = $node->hasField('feeds_item') && !$node->get('feeds_item')->isEmpty();
    if (!$is_feeds_import && $node->isNew() && \Drupal::currentUser()->hasPermission('publish calendar_event content immediately')) {
      $node->setPublished();
    }

    if ($is_feeds_import) {
      _apc_calendar_fix_feeds_all_day_timezone($node);
    }
    return;
  }

  // community_photo defaults to unpublished (core.base_field_override.node.
  // community_photo.status.yml), same moderation mechanic as calendar_event
  // above -- see photo-gallery-specs.md, "Moderation bypass": no role has
  // this permission yet, so every submission queues until that's revisited.
  if ($node->bundle() === 'community_photo') {
    if ($node->isNew() && \Drupal::currentUser()->hasPermission('publish community_photo content immediately')) {
      $node->setPublished();
    }
  }
}

/**
 * Re-anchors Feeds-imported all-day events from UTC midnight to local midnight.
 *
 * feeds_ical (IcalParser.php) hardcodes 'defaultTimeZone' => 'UTC' when
 * instantiating the underlying ICal library, with no feed-type setting to
 * override it. A bare iCal all-day value (VALUE=DATE, no TZID -- e.g.
 * DTSTART;VALUE=DATE:20260913) has no timezone of its own by spec, so the
 * library resolves it against that hardcoded default and produces a
 * timestamp for 2026-09-13 00:00:00 UTC. Rendered in the site's actual
 * default timezone (America/Chicago), that is 2026-09-12 19:00 -- the event
 * displays starting the previous evening at 7pm instead of as an all-day
 * event. Confirmed live against the Forward TX feed's all-day entries
 * (event-import-task.md).
 *
 * Detected narrowly: a Smart Date item with the site's own "all day"
 * convention (duration exactly 1440 minutes) whose start AND end both land
 * on an exact UTC midnight. A genuine 24-hour timed event beginning at local
 * midnight would not hit this signature except in the one timezone where
 * local and UTC midnight coincide, so this does not misfire on real timed
 * events. Re-anchoring computes each date's actual local midnight via PHP's
 * timezone database, so it stays correct across the DST boundary rather than
 * applying a fixed offset.
 */
function _apc_calendar_fix_feeds_all_day_timezone(NodeInterface $node): void {
  if (!$node->hasField('field_event_date') || $node->get('field_event_date')->isEmpty()) {
    return;
  }

  $item = $node->get('field_event_date')->first();
  $start = (int) $item->value;
  $end = (int) $item->end_value;
  $duration = (int) $item->duration;

  if ($duration !== 1440 || $start % 86400 !== 0 || $end % 86400 !== 0) {
    return;
  }

  $item->value = _apc_calendar_utc_midnight_to_local($start);
  $item->end_value = _apc_calendar_utc_midnight_to_local($end);
}

/**
 * Returns the timestamp for local midnight on the UTC date $utc_timestamp falls on.
 *
 * @see _apc_calendar_fix_feeds_all_day_timezone()
 */
function _apc_calendar_utc_midnight_to_local(int $utc_timestamp): int {
  $site_timezone = new \DateTimeZone(\Drupal::config('system.date')->get('timezone.default') ?: date_default_timezone_get());
  $date = new \DateTime('@' . $utc_timestamp);
  $date->setTimezone(new \DateTimeZone('UTC'));
  $local_midnight = new \DateTime($date->format('Y-m-d') . ' 00:00:00', $site_timezone);
  return $local_midnight->getTimestamp();
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node entities.
 *
 * Notify the site email address when an anonymous visitor submits an event, so
 * the pending queue at /admin/content?type=calendar_event&status=2 does not sit
 * unreviewed simply because nobody knew it had items in it.
 */
function apc_calendar_node_insert(NodeInterface $node): void {
  if ($node->bundle() !== 'calendar_event' || $node->isPublished()) {
    return;
  }
  if (!\Drupal::currentUser()->isAnonymous()) {
    return;
  }

  $site_config = \Drupal::config('system.site');
  $to = \Drupal::state()->get('apc_calendar.notify_email') ?: $site_config->get('mail');
  if (empty($to)) {
    \Drupal::logger('apc_calendar')->warning('Pending event @nid submitted but no notification address is configured.', ['@nid' => $node->id()]);
    return;
  }

  // toString(TRUE) returns a GeneratedUrl so cacheability metadata is captured
  // rather than leaking out of an early-rendering context.
  $params = [
    'node' => $node,
    'site_name' => $site_config->get('name'),
    'edit_url' => $node->toUrl('edit-form', ['absolute' => TRUE])->toString(TRUE)->getGeneratedUrl(),
    'queue_url' => Url::fromUserInput('/admin/content', [
      'absolute' => TRUE,
      'query' => ['type' => 'calendar_event', 'status' => '2'],
    ])->toString(TRUE)->getGeneratedUrl(),
  ];

  \Drupal::service('plugin.manager.mail')->mail(
    'apc_calendar',
    'event_pending',
    $to,
    \Drupal::languageManager()->getDefaultLanguage()->getId(),
    $params
  );
}

/**
 * Implements hook_ENTITY_TYPE_delete() for node entities.
 *
 * Deletes a community_photo's own media entity (and its file) when the node
 * goes -- Drupal never does this by default (an entity reference field
 * never cascades, since in general the referenced entity could be shared
 * elsewhere), but field_photo_image is cardinality-1 and, in the intended
 * design, every media entity it points to was created for that one node
 * alone via either the public submission form or PhotoBatchImporter. Left
 * alone, deleting the node orphans the media and its file forever;
 * confirmed live (2026-09-11) before this hook existed.
 *
 * Two checks guard against "intended design" not being a technical
 * guarantee, rather than assuming it (2026-09-11 correction, prompted by a
 * direct question about exactly this): the Media Library widget's own
 * "Browse" tab lets an editor pick an *already-existing* media entity
 * instead of uploading a new one, so two nodes CAN legitimately end up
 * sharing one media entity despite the field's intended 1:1 shape --
 * checked for directly below, since core has no generic "is this entity
 * referenced elsewhere" service the way it does for files. The file itself
 * is checked against Drupal's own file.usage tracking (the mechanism the
 * site owner specifically asked whether this used) after the media
 * entity's own usage row is gone, so a file some other media entity still
 * legitimately shares is left alone rather than deleted out from under it.
 *
 * The file is deleted explicitly, not left for Drupal's own cron-based
 * unused-file cleanup -- tested that assumption directly rather than trust
 * it, and it doesn't hold: file_cron() only ever considers files with
 * `status <> PERMANENT`, and every file attached to a saved media entity is
 * marked permanent. A permanent file at zero usage is invisible to that
 * cleanup -- confirmed live, the file was still sitting there, still
 * permanent, after the media entity was gone, before this was fixed.
 *
 * Scoped to community_photo only (2026-09-11 decision) -- field_event_image
 * (calendar_event) and field_media_image (blog_entry) have the same
 * dedicated-media shape, but the site owner wants those left at Drupal's
 * default (non-cascading) behavior for now.
 */
function apc_calendar_node_delete(NodeInterface $node): void {
  if ($node->bundle() !== 'community_photo') {
    return;
  }
  if (!$node->hasField('field_photo_image') || $node->get('field_photo_image')->isEmpty()) {
    return;
  }

  $media = $node->get('field_photo_image')->entity;
  if (!$media) {
    return;
  }

  // Is some OTHER node still pointing at this same media entity? (Media
  // Library's "Browse" tab makes this possible -- see the docblock above.)
  $other_usage = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'community_photo')
    ->condition('field_photo_image', $media->id())
    ->condition('nid', $node->id(), '<>')
    ->range(0, 1)
    ->execute();
  if ($other_usage) {
    return;
  }

  // The file entity has to be captured before the media entity is deleted --
  // deleting the media entity is what decrements the file's usage count via
  // ImageItem's own field-delete handling, but the field's own reference to
  // it is gone once that call returns.
  $file = $media->hasField('field_media_image') ? $media->get('field_media_image')->entity : NULL;
  $media->delete();

  // Only delete the file if nothing else is left using it. Deleting the
  // media entity above already removed *its* usage row; if the list isn't
  // empty now, some other media entity has its own separate usage row for
  // this same file (e.g. two Image media entities that both ended up
  // pointing at the same underlying file), and it isn't this hook's file to
  // delete.
  if ($file && empty(\Drupal::service('file.usage')->listUsage($file))) {
    $file->delete();
  }
}

/**
 * Implements hook_mail().
 */
function apc_calendar_mail(string $key, array &$message, array $params): void {
  if ($key !== 'event_pending') {
    return;
  }

  /** @var \Drupal\node\NodeInterface $node */
  $node = $params['node'];

  $message['subject'] = t('[@site] Event pending review: @title', [
    '@site' => $params['site_name'],
    '@title' => $node->label(),
  ]);

  $message['body'][] = t('A visitor submitted a new event. It is unpublished until someone approves it.');
  $message['body'][] = t('Title: @title', ['@title' => $node->label()]);

  if (!$node->get('field_location')->isEmpty() && $term = $node->get('field_location')->entity) {
    $message['body'][] = t('Location: @location (@status)', [
      '@location' => $term->label(),
      '@status' => $term->isPublished() ? t('existing') : t('NEW - also needs approval'),
    ]);
  }

  $message['body'][] = t('Review and publish: @url', ['@url' => $params['edit_url']]);
  $message['body'][] = t('Full pending queue: @url', ['@url' => $params['queue_url']]);
}

/**
 * Implements hook_entity_extra_field_info().
 *
 * Exposes "Directions" as a pseudo-field on locations so its placement is
 * config, not code: it can be positioned, reordered or switched off per view
 * mode from Manage Display, independently on default, card and compact_card.
 *
 * A Twig override would have needed a custom theme, and a Views field rewrite
 * would only have covered the location page — not the card embedded in event
 * pages and the calendar popup.
 */
function apc_calendar_entity_extra_field_info(): array {
  $fields = [];

  $fields['taxonomy_term']['locations']['display']['directions'] = [
    'label' => t('Directions'),
    'description' => t('Links to OpenStreetMap and Google Maps directions for this location.'),
    'weight' => 10,
    'visible' => FALSE,
  ];

  return $fields;
}

/**
 * Implements hook_ENTITY_TYPE_view() for taxonomy_term entities.
 */
function apc_calendar_taxonomy_term_view(array &$build, TermInterface $term, EntityViewDisplayInterface $display, $view_mode): void {
  if ($term->bundle() !== 'locations' || !$display->getComponent('directions')) {
    return;
  }

  $build['directions'] = apc_calendar_build_directions($term);
}

/**
 * Builds the directions links for a location term.
 *
 * Coordinates are preferred over the address: they are unambiguous, and they
 * route correctly even where the address itself cannot be geocoded — which is
 * common enough here that it is the reason the map is best-effort. The address
 * is the fallback, and both services will geocode it themselves.
 *
 * Renders "No directions available" rather than nothing when a location has
 * neither, so an editor reviewing the queue can see the location is incomplete
 * instead of wondering whether the feature is broken.
 */
function apc_calendar_build_directions(TermInterface $term): array {
  $destination = apc_calendar_get_directions_destination($term);

  if ($destination === NULL) {
    return [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['apc-directions', 'apc-directions--none']],
      '#value' => t('No directions available'),
    ];
  }

  $encoded = rawurlencode($destination);

  $services = [
    'osm' => [
      'title' => t('OpenStreetMap'),
      'url' => 'https://www.openstreetmap.org/directions?to=' . $encoded,
    ],
    'google' => [
      'title' => t('Google Maps'),
      'url' => 'https://www.google.com/maps/dir/?api=1&destination=' . $encoded,
    ],
  ];

  $build = [
    '#type' => 'container',
    '#attributes' => ['class' => ['apc-directions']],
    'label' => [
      '#type' => 'html_tag',
      '#tag' => 'span',
      '#attributes' => ['class' => ['apc-directions__label']],
      '#value' => t('Directions:'),
    ],
  ];

  foreach ($services as $key => $service) {
    $build[$key] = [
      '#type' => 'link',
      '#title' => $service['title'],
      '#url' => Url::fromUri($service['url']),
      '#attributes' => [
        'class' => ['apc-directions__link', 'apc-directions__link--' . $key],
        'target' => '_blank',
        // Without noopener the opened page gets a handle on this window.
        'rel' => 'noopener noreferrer',
      ],
    ];
  }

  return $build;
}

/**
 * Resolves the best available directions destination for a location term.
 *
 * Split out of apc_calendar_build_directions() so a single-link, single-
 * service consumer (the event detail page's "Get directions" button) can
 * reuse the same coordinates-preferred-over-address resolution without
 * duplicating it.
 *
 * @see apc_calendar_build_directions()
 */
function apc_calendar_get_directions_destination(TermInterface $term): ?string {
  if ($term->hasField('field_geofield') && !$term->get('field_geofield')->isEmpty()) {
    $geo = $term->get('field_geofield')->first();
    $lat = $geo->get('lat')->getValue();
    $lon = $geo->get('lon')->getValue();
    if ($lat !== NULL && $lon !== NULL) {
      return $lat . ',' . $lon;
    }
  }

  return apc_calendar_format_address($term);
}

/**
 * Builds a single Google Maps directions URL for a location term.
 *
 * For contexts that want one "Get directions" action (the event detail
 * page) rather than the full OSM+Google choice apc_calendar_build_directions()
 * renders on the location page itself.
 */
function apc_calendar_get_directions_url(TermInterface $term): ?string {
  $destination = apc_calendar_get_directions_destination($term);
  if ($destination === NULL) {
    return NULL;
  }

  return 'https://www.google.com/maps/dir/?api=1&destination=' . rawurlencode($destination);
}

/**
 * Formats a location's address as a single line for a map service query.
 *
 * Returns NULL when there is nothing usable, so callers can distinguish "no
 * address" from an address that happens to be sparse.
 */
function apc_calendar_format_address(TermInterface $term): ?string {
  if (!$term->hasField('field_address') || $term->get('field_address')->isEmpty()) {
    return NULL;
  }

  $address = $term->get('field_address')->first();
  $parts = array_filter([
    $address->get('address_line1')->getValue(),
    $address->get('address_line2')->getValue(),
    $address->get('locality')->getValue(),
    trim(implode(' ', array_filter([
      $address->get('administrative_area')->getValue(),
      $address->get('postal_code')->getValue(),
    ]))),
  ], static fn ($part) => is_string($part) && trim($part) !== '');

  return $parts ? implode(', ', $parts) : NULL;
}

/**
 * Implements hook_library_info_alter().
 *
 * Point Moment and RRule at their real composer-installed paths. The npm
 * package layouts don't match the locations fullcalendar_view expects, so
 * without this its own alter finds nothing on disk and silently falls back to
 * loading them from jsdelivr/unpkg.
 *
 * Hook order does not matter here. fullcalendar_view's alter only substitutes
 * a CDN URL when file_exists() fails on the path it finds — so if it runs after
 * this, its check passes and it leaves these alone; if it runs before, this
 * simply overwrites its CDN substitution.
 */
function apc_calendar_library_info_alter(array &$libraries, string $module): void {
  if ($module !== 'fullcalendar_view') {
    return;
  }
  $paths = [
    'libraries.moment' => '/libraries/moment/min/moment.min.js',
    'libraries.rrule' => '/libraries/rrule/dist/es5/rrule.min.js',
  ];
  foreach ($paths as $library => $path) {
    if (isset($libraries[$library]['js'])) {
      $libraries[$library]['js'] = [$path => ['minified' => TRUE]];
    }
  }
}

/**
 * Implements hook_file_insert().
 *
 * Strips EXIF/XMP metadata -- most importantly GPS coordinates and a precise
 * timestamp -- from every uploaded JPEG by re-encoding it with GD, which does
 * not carry EXIF forward. This runs at the single point every upload path
 * passes through (admin Media Library today; a future Dropzone/public-form
 * path and a future import later) rather than needing the same logic
 * duplicated per entry point. See photo-gallery-specs.md, "Privacy and
 * safety" -- these are potentially protest photos, where GPS/timestamp
 * metadata is a real de-anonymization risk (home address, exact
 * location/time), and unlike a resized image style derivative (which already
 * loses EXIF as a side effect of GD re-encoding), the *original* uploaded
 * file is what the gallery lightbox deliberately links to for the full-size
 * view -- so without this, the one place the site exposes the original file
 * is exactly the place GPS data would otherwise still be sitting in it.
 *
 * A phone photo's orientation is stored as an EXIF tag, not baked into the
 * pixels, so that tag is read and applied as a real rotation/flip BEFORE the
 * strip -- otherwise a portrait photo would look sideways for any consumer
 * that isn't also honouring the (now-removed) tag.
 *
 * Deliberately GD-only (core's own image toolkit), not shelling out to
 * exiftool -- avoids depending on a system binary and shell_exec being
 * available on GreenGeeks' shared hosting, which isn't confirmed either way.
 * Scoped to JPEG only; PNG/GIF pass through untouched, since GPS EXIF is a
 * JPEG/TIFF convention, not something those formats carry.
 */
function apc_calendar_file_insert(FileInterface $file): void {
  if ($file->getMimeType() !== 'image/jpeg') {
    return;
  }

  $uri = $file->getFileUri();
  $path = \Drupal::service('file_system')->realpath($uri);
  if (!$path || !is_readable($path)) {
    return;
  }

  // Read the orientation tag before the re-encode below removes it.
  $orientation = NULL;
  if (function_exists('exif_read_data')) {
    $exif = @exif_read_data($path);
    if (is_array($exif) && !empty($exif['Orientation'])) {
      $orientation = (int) $exif['Orientation'];
    }
  }

  $image = @imagecreatefromjpeg($path);
  if ($image === FALSE) {
    // Not a real/decodable JPEG despite the MIME type -- leave the file
    // alone rather than risk corrupting something imagejpeg() can't recreate.
    return;
  }

  $image = apc_calendar_apply_exif_orientation($image, $orientation);

  // imagejpeg() writes a fresh JPEG from the decoded raster data and does not
  // carry EXIF/XMP forward -- this re-encode is the strip, not a separate
  // "remove metadata" step. Quality matches core's own GD toolkit setting so
  // this doesn't silently change upload quality from what site config
  // already expects.
  $quality = (int) (\Drupal::config('system.image.gd')->get('jpeg_quality') ?? 75);
  imagejpeg($image, $path, $quality);
  imagedestroy($image);

  clearstatcache(TRUE, $path);
}

/**
 * Applies an EXIF orientation tag to a GD image as a real pixel transform.
 *
 * Extracted from apc_calendar_file_insert() so the batch-import prep command
 * can build orientation-correct thumbnails with exactly the same mapping.
 * Those thumbnails are what gets looked at when captions and focal points are
 * written, so a thumbnail that disagrees with the imported file about which
 * way is up would put the focal point in the wrong place -- worth one shared
 * function rather than two switches that can drift apart.
 *
 * imagerotate()'s angle is counter-clockwise, so a tag meaning "this image
 * needs a 90 degree clockwise turn to be upright" (6) is a *negative* angle.
 *
 * @param \GdImage $image
 *   The decoded image, modified in place for the flip-only cases.
 * @param int|null $orientation
 *   The EXIF Orientation tag value, or NULL when there was none.
 *
 * @return \GdImage
 *   The corrected image -- imagerotate() returns a new resource, so callers
 *   must use the return value rather than assuming in-place modification.
 */
function apc_calendar_apply_exif_orientation(\GdImage $image, ?int $orientation): \GdImage {
  switch ($orientation) {
    case 2:
      imageflip($image, IMG_FLIP_HORIZONTAL);
      break;

    case 3:
      $image = imagerotate($image, 180, 0);
      break;

    case 4:
      imageflip($image, IMG_FLIP_VERTICAL);
      break;

    case 5:
      imageflip($image, IMG_FLIP_VERTICAL);
      $image = imagerotate($image, -90, 0);
      break;

    case 6:
      $image = imagerotate($image, -90, 0);
      break;

    case 7:
      imageflip($image, IMG_FLIP_HORIZONTAL);
      $image = imagerotate($image, -90, 0);
      break;

    case 8:
      $image = imagerotate($image, 90, 0);
      break;
  }

  return $image;
}

/**
 * Implements hook_views_query_alter().
 *
 * The `imported_events` view (event-import-task.md) needs to show pending
 * Feeds-imported events that are either upcoming *or* part of a recurring
 * series -- feeds_ical does not expand RRULE, so a weekly meeting running
 * since last year is represented by a single node whose event date is that
 * old series start, not by its future occurrences. A plain "date >= now"
 * filter would hide it, and every other open-ended recurring series, from
 * the curation queue forever.
 *
 * This can't be built as a Views UI filter group: the documented way to
 * express "A OR B" across two different fields is to duplicate the view's
 * other filters (type, field_import_state) into a second OR'd group, but
 * doing that here triggers a Views query-builder bug -- the second copy's
 * auto-generated table join for field_import_state carries a self-
 * contradicting `!= 'pending'` condition, so that whole group can never
 * match any row (confirmed by dumping the built SQL). Added directly to
 * the query instead, reusing the table aliases Views already joins for the
 * view's own (visible) Event Date and Recurrence columns.
 */
function apc_calendar_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() !== 'imported_events' || $view->current_display !== 'page_1') {
    return;
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  // The view already displays both of these as fields, but relying on that
  // to guarantee their table joins isn't safe: the pager's separate COUNT
  // query strips joins that only serve SELECT-ed display fields, so a join
  // that exists in the main query can silently be missing here (confirmed
  // live -- the COUNT query 500'd with "Unknown column
  // node__field_import_recurrence_raw...", exactly this). Force both joins
  // explicitly instead of trusting the display fields to provide them,
  // using the same join shape every Drupal field table uses (entity_id =
  // host id, deleted = 0).
  $join_manager = \Drupal::service('plugin.manager.views.join');
  $force_join = function (string $table) use ($query, $join_manager): string {
    /** @var \Drupal\views\Plugin\views\join\JoinPluginBase $join */
    $join = $join_manager->createInstance('standard', [
      'table' => $table,
      'field' => 'entity_id',
      'left_table' => 'node_field_data',
      'left_field' => 'nid',
      'type' => 'LEFT',
      'extra' => [
        ['field' => 'deleted', 'value' => 0, 'numeric' => TRUE],
      ],
    ]);
    return $query->ensureTable($table, NULL, $join);
  };

  $date_alias = $force_join('node__field_event_date');
  $recurrence_alias = $force_join('node__field_import_recurrence_raw');

  $query->addWhereExpression(0, "($date_alias.field_event_date_value >= :apc_imported_events_now OR $recurrence_alias.field_import_recurrence_raw_value IS NOT NULL)", [
    ':apc_imported_events_now' => \Drupal::time()->getRequestTime(),
  ]);
}

/**
 * Implements hook_theme().
 *
 * Registers a theme hook that ships with contrib module focal_point
 * (2.1.2) but that its own hook_theme() never declares -- see
 * focal_point.module, which only registers focal_point_preview_page even
 * though FocalPointImageWidget::process() unconditionally sets
 * $element['#theme'] = 'focal_point_media_library_image_widget' whenever the
 * widget renders inside a Media Library "Add media" form, and the module
 * ships a matching template (templates/focal-point-media-library-image-
 * widget.html.twig) for it. Confirmed live: uploading through Media Library
 * (both the calendar_event and community_photo forms use it, for anonymous
 * and authenticated users alike) creates the focal-point field and its
 * hidden coordinate input, but the crosshair indicator overlay -- which
 * requires this theme hook to render at all -- never appears, so the widget
 * looks like plain "Alternative text only" with no way to set a focal point.
 *
 * Declared here rather than patched into the contrib module so it survives
 * `composer update drupal/focal_point`. 'base hook' => 'image_widget'
 * reuses core's template_preprocess_image_widget() (image.field.inc), which
 * is exactly what the template needs: it consumes the same $attributes and
 * $data variables that hook builds, just via a different template file.
 */
function apc_calendar_theme(): array {
  return [
    'focal_point_media_library_image_widget' => [
      'render element' => 'element',
      'base hook' => 'image_widget',
      // The template lives in focal_point's own templates/ directory, not
      // this module's -- Drupal's default lookup path is the declaring
      // module's own templates/, so it has to be pointed there explicitly.
      'path' => \Drupal::service('extension.list.module')->getPath('focal_point') . '/templates',
      'template' => 'focal-point-media-library-image-widget',
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for media_library_add_form_dropzonejs.
 *
 * The real fix for item J's "focal point crosshair never appears in Media
 * Library" bug -- the hook_theme() registration above (apc_calendar_theme())
 * turned out to be necessary but not sufficient. The actual mechanism that
 * makes the crosshair visible lives in
 * focal_point_form_media_library_add_form_upload_alter() (focal_point.module):
 * it adds a #process callback, _focal_point_replace_media_library_preview(),
 * that copies the field widget's own preview (indicator + thumbnail, normally
 * hidden by Media Library behind #access = FALSE in favor of Media Library's
 * own static preview) into Media Library's real preview slot at
 * ['media', $delta, 'preview', 'thumbnail']. That hook is keyed to the exact
 * form ID media_library_add_form_upload, which is dropzonejs's pre-rename
 * form ID -- dropzonejs renames it to media_library_add_form_dropzonejs (see
 * the long comment on _apc_calendar_ensure_anonymous_session() above), so the
 * hook, and the #process callback it registers, never ran. This is a known,
 * already-fixed-upstream bug: https://www.drupal.org/project/focal_point/issues/3344369
 * ("Compatibility with DropzoneJS") was committed to the 2.x branch
 * 2025-02-27 but has not shipped in a tagged release as of 2.1.2 (the version
 * this site runs) -- the upstream fix adds exactly this hook, under exactly
 * this name, calling the same existing alter logic. Implemented here instead
 * of waiting for a release (or patching the contrib module) so it survives a
 * `composer update` regardless of when focal_point actually tags one; safe to
 * delete once an installed release includes it.
 *
 * Verified live (2026-09-07): uploading through this exact dialog now shows
 * the crosshair at the correct default position, and dragging it updates the
 * hidden focal-point field -- confirmed both by DOM inspection
 * (.focal-point-indicator present, correctly positioned) and by checking the
 * field's value changed after a click elsewhere on the image.
 */
function apc_calendar_form_media_library_add_form_dropzonejs_alter(array &$form, FormStateInterface $form_state): void {
  focal_point_form_media_library_add_form_upload_alter($form, $form_state);
  _apc_calendar_add_focal_point_explanation($form, $form_state);
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter() for image_focal_point.
 *
 * Pre-fills the alt text field from the uploaded file's own name. The alt
 * field is otherwise blank by default, and a submitter -- especially an
 * anonymous one uploading a single photo in a hurry -- will often just
 * leave it blank or type something unhelpful. The uploaded file's own name
 * is usually at least somewhat descriptive ("rally-at-city-hall.jpg", a
 * phone's auto-generated "IMG_1234.jpg" being the obvious exception this
 * doesn't try to solve), so it's a better starting point than nothing --
 * always a suggestion, never forced: sets only a #default_value, freely
 * overwritable, and only when the field doesn't already have a value
 * (existing media being re-edited already has real alt text).
 *
 * Also rewrites the alt field's description: core's own wording
 * ("Short description of the image used by screen readers and displayed
 * when the image is not loaded. This is important for accessibility.",
 * ImageWidget::process()) explains what alt text *is* but not what to
 * *write*, which matters most for an anonymous submitter who has never
 * filled in an alt field before.
 *
 * This can't be done in a plain hook_form_alter(): 'alt' doesn't exist yet
 * at that point. ImageWidget::formElement() (which FocalPointImageWidget's
 * own formElement() calls via parent::) only registers its own
 * ImageWidget::process() as a #process callback -- the 'alt'/'preview'/
 * 'focal_point' sub-elements aren't actually built until that #process
 * callback runs later, well after every hook_form_alter has already fired
 * (confirmed live by dumping array_keys() at hook_form_alter time: 'alt'
 * genuinely isn't there yet). This hook fires right after formElement()
 * returns (WidgetBase::formSingleElement()), by which point '#process'
 * already has ImageWidget::process() queued but hasn't run it -- appending
 * a second callback here relies on Drupal invoking #process callbacks in
 * array order, so this one runs immediately after the widget's own and
 * 'alt' already exists by then.
 */
function apc_calendar_field_widget_single_element_image_focal_point_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  // Computed here (not inside the #process callback below) and stashed as a
  // plain '#'-prefixed property, rather than captured by a closure: render
  // arrays get serialized into the form cache between requests, and PHP
  // cannot serialize a Closure -- confirmed live, using a closure here
  // threw "Serialization of 'Closure' is not allowed" on the very first
  // AJAX round trip.
  $filename = pathinfo($context['items']->getEntity()->label(), PATHINFO_FILENAME);
  $element['#apc_suggested_alt'] = trim(preg_replace('/[-_]+/', ' ', $filename));
  $element['#process'][] = '_apc_calendar_process_suggest_alt_text';
}

/**
 * #process callback: applies the suggested alt text stashed by the alter
 * hook above, and rewrites the alt field's description, once
 * ImageWidget::process() (queued first) has actually built the 'alt'
 * sub-element.
 *
 * @see apc_calendar_field_widget_single_element_image_focal_point_form_alter()
 */
function _apc_calendar_process_suggest_alt_text(array $element, FormStateInterface $form_state, array $form): array {
  if (empty($element['alt'])) {
    return $element;
  }
  if (empty($element['alt']['#default_value']) && !empty($element['#apc_suggested_alt'])) {
    $element['alt']['#default_value'] = $element['#apc_suggested_alt'];
  }
  $element['alt']['#description'] = t('Please provide a short description of the image so screen readers can explain to visually impaired users what is in the image.');
  return $element;
}

/**
 * Explains the focal point crosshair in the Media Library "Add media" dialog.
 *
 * field_media_image's own field description ("After uploading, click on the
 * photo to mark its most important part...") is configured
 * (field.field.media.image.field_media_image.yml) and does display on the
 * plain /media/{id}/edit form, but never reaches this dialog -- confirmed
 * live, zero `.description` elements anywhere in the rendered markup here,
 * even after the crosshair itself was fixed to appear (see
 * apc_calendar_form_media_library_add_form_dropzonejs_alter() above). Media
 * Library builds this field into $element['fields'] via a plain
 * EntityFormDisplay::buildForm() call, the same mechanism the standalone
 * edit form uses, so the description is presumably still attached to the
 * widget's own #description property -- it just never gets printed, most
 * likely because the image/focal_point widget's own theme templates
 * (image-widget.html.twig, focal-point-media-library-image-widget.html.twig)
 * never output {{ description }} at all, unlike the generic form-element
 * wrapper the standalone edit form's field happens to render through. Not
 * chased further -- added directly here instead, next to the image itself
 * (in the relocated preview slot Media Library actually displays) rather
 * than depending on wherever the widget's own description would have gone.
 *
 * Anonymous submitters see this every time (Media Library is their only way
 * to upload), which is exactly who needs the explanation most -- an admin
 * editing an existing photo has the standalone edit form's real description
 * to fall back on.
 */
function _apc_calendar_add_focal_point_explanation(array &$form, FormStateInterface $form_state): void {
  $media = $form_state->get('media') ?: [];
  /** @var \Drupal\media\MediaInterface $item */
  foreach ($media as $delta => $item) {
    $fields = &$form['media'][$delta]['fields'];
    $source_field = $fields['#source_field_name'] ?? NULL;
    if ($source_field === NULL || !isset($fields[$source_field])) {
      continue;
    }
    $component = \Drupal::service('entity_display.repository')
      ->getFormDisplay('media', $item->bundle(), 'media_library')
      ->getComponent($source_field);
    if (!$component || $component['type'] !== 'image_focal_point') {
      continue;
    }
    $description = $item->hasField($source_field) ? $item->{$source_field}->getFieldDefinition()->getDescription() : NULL;
    if (empty($description)) {
      continue;
    }
    $form['media'][$delta]['preview']['focal_point_help'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => $description,
      '#attributes' => ['class' => ['apc-focal-point-help']],
      '#weight' => 5,
      // .media-library-add-form__preview is a narrow, single-row flex
      // container sized for just the thumbnail -- without this, the
      // paragraph squeezes into whatever space is left beside the image
      // instead of wrapping below it. See css/focal-point-help.css.
      '#attached' => ['library' => ['apc_calendar/focal_point_help']],
    ];
  }
}


